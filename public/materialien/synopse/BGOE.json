{"erlass":"BGOE","eli":"cc/2006/355","normProfil":"entstehung-norm/1","erzeugt":"2026-09-11","fensterAb":"2023-09-01","kuenftigeStaende":[],"staende":[{"datum":"2023-09-01","xmlUrl":"https://fedlex.data.admin.ch/filestore/fedlex.data.admin.ch/eli/cc/2006/355/20230901/de/xml/fedlex-data-admin-ch-eli-cc-2006-355-20230901-de-xml-7.xml","liveUrl":"https://www.fedlex.admin.ch/eli/cc/2006/355/20230901/de","sha":"452595f956c64923a43ea2c14d87053a411369bf94e3cb4af0ea6a22ee4c6f9a","bytes":39227,"abgerufen":"2026-09-11","artikelZahl":24},{"datum":"2023-11-01","xmlUrl":"https://fedlex.data.admin.ch/filestore/fedlex.data.admin.ch/eli/cc/2006/355/20231101/de/xml/fedlex-data-admin-ch-eli-cc-2006-355-20231101-de-xml-7.xml","liveUrl":"https://www.fedlex.admin.ch/eli/cc/2006/355/20231101/de","sha":"f04249ce76ebe47c899c4de2c8fb964bcb21ea67b742d185d07e0487520c4a54","bytes":42587,"abgerufen":"2026-09-11","artikelZahl":25}],"schritte":[{"von":"2023-09-01","bis":"2023-11-01","neuEIds":["art_23_a"],"ereignisOhneAenderung":["23_a"],"artikel":[{"eId":"art_17","token":"17","label":"Art. 17","ueberschrift":"Gebühren","art":"geaendert","alt":[["1","","Für den Zugang zu amtlichen Dokumenten wird in der Regel eine Gebühr erhoben."],["2","","Keine Gebühren werden erhoben:"],["2","a.","wenn die Bearbeitung eines Gesuches einen geringen Aufwand erfordert;"],["2","b.","für Schlichtungsverfahren (Art. 13); und"],["2","c.","für Verfahren auf Erlass einer Verfügung (Art. 15)."],["3","","Der Bundesrat legt die Einzelheiten und den Gebührentarif nach Aufwand fest. Abweichende Gebührenregelungen durch die Spezialgesetzgebung bleiben vorbehalten."],["4","","Für die Abgabe von Berichten, Broschüren oder anderen Drucksachen und Informationsträgern kann in jedem Fall eine Gebühr erhoben werden."]],"shaNorm":"40f3b935a39dad57e56f7c4240ca13252a7650caecd8b3af38998e138f67e305","zustand":"belegt","oc":["oc/2023/584"]}]}]}

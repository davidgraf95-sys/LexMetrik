{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/634.5/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über die Wehrpflichtersatzabgabe (KWPEV) (LS 634.5)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Kantonale Behörde für die Wehrpflichtersatzabgabe sowie Veranlagungsbehörde im Sinne des Bundesgesetzes über die Wehrpflichtersatzabgabe (WPEG) ist die Abteilung Wehrpflichtersatzverwaltung des Amtes für Militär und Zivilschutz."
        },
        {
          "absatz": "2",
          "text": "Rekurskommission im Sinne von Art. 22 Abs. 3 WPEG sind die Steuerrekurskommissionen*."
        }
      ],
      "stand": "2010-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-634_5-2004_05_26-2004_07_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "4bc19fe92c8c7fc835b2ac4f754c3faacc2e32dc765c1a96ab4415ce666a0f24",
      "sha": "5c672356b3a327b22abbaaf0e26edd81bd620cb481ac67dfcb4b2fe94e6e6331"
    },
    {
      "id": "kanton/ZH/634.5/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über die Wehrpflichtersatzabgabe (KWPEV) (LS 634.5)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": null,
          "text": "Aufgehoben"
        }
      ],
      "stand": "2010-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-634_5-2004_05_26-2004_07_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "4bc19fe92c8c7fc835b2ac4f754c3faacc2e32dc765c1a96ab4415ce666a0f24",
      "sha": "fffd896179b5a05de5123ab834ecf45024e7a99fc81a9e6dc269c8d0b54294f4"
    },
    {
      "id": "kanton/ZH/634.5/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über die Wehrpflichtersatzabgabe (KWPEV) (LS 634.5)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Amtshilfe der Gemeinden umfasst insbesondere:",
          "items": [
            {
              "marke": "a",
              "text": "Ausfüllen und Weiterleiten der Hilfsblätter von Ersatzpflichtigen gemäss den Weisungen des kantonalen Steueramtes,"
            },
            {
              "marke": "b",
              "text": "Erteilung von Auskünften über die für die Veranlagung und den Bezug erforderlichen Daten von Ersatzpflichtigen,"
            },
            {
              "marke": "c",
              "text": "Meldung von Erbfällen an die Abteilung Wehrpflichtersatzverwaltung, sobald einem landesabwesenden Wehrpflichtigen aufgrund amtlicher Inventarisation in der Schweiz liegendes Vermögen anfällt."
            }
          ]
        }
      ],
      "stand": "2010-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-634_5-2004_05_26-2004_07_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "4bc19fe92c8c7fc835b2ac4f754c3faacc2e32dc765c1a96ab4415ce666a0f24",
      "sha": "10a8bdeb7a84b603b80f52766f91f9eec0bf8e2f97708841a96bd44cfd55766f"
    },
    {
      "id": "kanton/ZH/634.5/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über die Wehrpflichtersatzabgabe (KWPEV) (LS 634.5)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das kantonale Steueramt meldet der Abteilung Wehrpflichtersatzverwaltung von jedem im Kanton wohnhaften Ersatzpflichtigen",
          "items": [
            {
              "marke": "a",
              "text": "die für die Ersatzabgabe massgebenden Bestandteile des Einkommens aufgrund der Einschätzung zur direkten Bundessteuer oder, wenn keine solche vorliegt, zur Staatssteuer,"
            },
            {
              "marke": "b",
              "text": "das Ergebnis von Revisionen für die direkte Bundessteuer oder die Staatssteuer,"
            },
            {
              "marke": "c",
              "text": "die Eröffnung sowie das Ergebnis eines Nachsteuerverfahrens für die direkte Bundessteuer oder die Staatssteuer. * Heute: Steuerrekursgericht."
            }
          ]
        },
        {
          "absatz": "2",
          "text": "Das kantonale Steueramt gewährt der Abteilung Wehrpflichtersatzverwaltung Einsicht in die Akten der direkten Bundessteuer und der Staatssteuer von Ersatzpflichtigen. Es ermöglicht den Zugriff auf die für die Veranlagung und den Bezug der Ersatzabgabe erforderlichen Daten."
        }
      ],
      "stand": "2010-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-634_5-2004_05_26-2004_07_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "4bc19fe92c8c7fc835b2ac4f754c3faacc2e32dc765c1a96ab4415ce666a0f24",
      "sha": "42096e85a62010f8623f5d39cc8aaa00e980461212673c4807d385cc7273850a"
    },
    {
      "id": "kanton/ZH/634.5/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über die Wehrpflichtersatzabgabe (KWPEV) (LS 634.5)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Diese Verordnung tritt am 1. Juli 2004 in Kraft."
        },
        {
          "absatz": "2",
          "text": "Auf den gleichen Zeitpunkt wird die Verordnung über den Wehrpflichtersatz vom 26. Oktober 1988 aufgehoben."
        }
      ],

{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/632.11/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das kantonale Steueramt vollzieht das Erbschafts- und Schenkungssteuergesetz (ESchG) vom 28. September 1986, soweit nachfolgend nichts Abweichendes geregelt ist."
        },
        {
          "absatz": "2",
          "text": "Die Finanzdirektion entscheidet über Rekurse gemäss §§ 61 Abs. 2 und 64 Abs. 2 ESchG."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "4c911ebd2d31601390ed63608035922e18d20859ec9881121afec5abc3f5bc35"
    },
    {
      "id": "kanton/ZH/632.11/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": null,
          "text": "Es gelten sinngemäss:",
          "items": [
            {
              "marke": "a",
              "text": "§ 119 des Steuergesetzes über den Ausstand,"
            },
            {
              "marke": "b",
              "text": "§§ 2–15, § 21 Abs. 1 und 2 sowie §§ 23–25 der Verordnung zum Steuergesetz."
            }
          ]
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "cf3d2f817e2f840ff1409a82ff9beb9d3d8a1d286515cf1f3756456fc6929eab"
    },
    {
      "id": "kanton/ZH/632.11/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": null,
          "text": "Ausgleichs- und Nachsteuerzinsen werden wie Steuern behandelt und im Veranlagungsverfahren festgesetzt."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "dd147e4f50aa918687aab755535910e9fe893c38571addd70819dc0244cfe392"
    },
    {
      "id": "kanton/ZH/632.11/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Hat der Empfänger einer steuerbaren Schenkung die Steuererklärung für die Schenkungssteuer nicht oder verspätet eingereicht, wird ein Ausgleichszins erhoben, wenn die Steuererklärung bis 31. März des auf den Vollzug der Schenkung folgenden Kalenderjahres nicht eingereicht wird."
        },
        {
          "absatz": "2",
          "text": "Absatz 1 gilt sinngemäss, wenn Personen, denen eine Steuerermässigung im Sinn von § 25 a des Gesetzes gewährt wurde, nach Eintritt der Voraussetzungen für eine Nachveranlagung nicht innert Frist eine Steuererklärung einreichen."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "8a12b2a38b3146c6233c6f12dd7da420f3e5aeafd5c7bb7ad304061af5777dbe"
    },
    {
      "id": "kanton/ZH/632.11/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": null,
          "text": "Der Ausgleichszins wird ab 1. April des auf den Vollzug der Schenkung oder den Eintritt der Voraussetzungen für die Nachveranlagung folgenden Kalenderjahres bis zum Eingangsdatum der Steuererklärung oder bei unterlassener Einreichung bis zum Tag der Veranlagung berechnet."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "c513fc879c331338e96c18b4d4f258a33ff155c774e15895f4e4d45d6e6a18c3"
    },
    {
      "id": "kanton/ZH/632.11/art_6",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "6",
      "artikelLabel": "§ 6",
      "bloecke": [
        {
          "absatz": null,
          "text": "Der Nachsteuerzins wird ab dem Zeitpunkt des Eintritts der Rechtskraft der Veranlagung bis zum Zeitpunkt der Einleitung des Nachsteuerverfahrens berechnet. Bei Selbstanzeige wird der Nachsteuerzins nur bis zum Datum ihres Eingangs berechnet."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "bb563b4f5d0713d4ef410551567b91574c73d796d3aa191acdc0a972f99836bd"
    },
    {
      "id": "kanton/ZH/632.11/art_7",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Zinssätze für Ausgleichs- und Nachsteuerzinsen werden durch die Finanzdirektion festgesetzt."
        },
        {
          "absatz": "2",
          "text": "Die Finanzdirektion bestimmt, inwieweit wegen Geringfügigkeit auf die Erhebung von Ausgleichs- und Nachsteuerzinsen verzichtet wird."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "5807065ae2c6f3bc5abab7c14e9101555ab9f93b72fd945d8eb887254529f814"
    },
    {
      "id": "kanton/ZH/632.11/art_8",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "8",
      "artikelLabel": "§ 8",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Vergütungszinsen auf Erbschafts- und Schenkungssteuervorauszahlungen werden im Umfang der veranlagten Steuer ausgerichtet."
        },
        {
          "absatz": "2",
          "text": "Die Vorauszahlung wird vom Tag der Steuerzahlung an bis zum Tag der Veranlagung zu den in den jeweiligen Zeiträumen gültigen Sätzen verzinst."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "4a71d252bc53dbdc458e9efec5c346e556b7d3aed55d4cf67385c7511bcc7dff"
    },
    {
      "id": "kanton/ZH/632.11/art_9",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "9",
      "artikelLabel": "§ 9",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Steuerrückerstattungen infolge Herabsetzung des Steuerbetrags im Rechtsmittelverfahren werden vom Tag der Zahlung an, frühestens aber nach Ablauf der Zahlungsfrist, bis zum Tag der Steuerrückerstattung verzinst."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "f4e07e29b0f9edff7de7a6b79d5b07b45edea520d10a39dee3ea949c4361965c"
    },
    {
      "id": "kanton/ZH/632.11/art_10",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "10",
      "artikelLabel": "§ 10",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Finanzdirektion setzt die Zinssätze für Vergütungsund Verzugszinsen sowie für Zinsen auf Steuerrückerstattungen fest."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "51e727e7641c786fcbc58e43faf7981a740b015a02e5cb903541f4969c195765"
    },
    {
      "id": "kanton/ZH/632.11/art_11",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "11",
      "artikelLabel": "§ 11",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Stundung und Ratenzahlungen sind nur zu bewilligen, wenn die Zahlung des Steuerbetrags für den Steuerpflichtigen eine Härte bedeutet und ausreichende Sicherheit durch Hinterlegen guter Wertpapiere, Grundpfandverschreibung oder Solidarbürgschaft geleistet wird."
        },
        {
          "absatz": "2",
          "text": "Auf Sicherstellung kann verzichtet werden, wenn das der Erbschafts- oder Schenkungssteuer unterliegende Vermögen seit dem Übergang auf den Steuerpflichtigen ohne sein Verschulden einen erheblichen Wertzerfall erfahren hat und der Steuerpflichtige nicht über genügend andere Mittel verfügt."
        },
        {
          "absatz": "3",
          "text": "Dem Empfänger einer periodischen Leistung, ausgenommen Nutzniessungsberechtigten, sind Ratenzahlungen zu bewilligen, wenn der Steuerpflichtige nicht über genügend andere Mittel für die Zahlung des Steuerbetrags verfügt."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "f98922477a324dd040c1d7512b2b2c0376c7c96883ca578a19377c29478bb366"
    },
    {
      "id": "kanton/ZH/632.11/art_12",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "12",
      "artikelLabel": "§ 12",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Bestimmungen dieser Verordnung finden nach ihrem Inkrafttreten auf sämtliche Erbschafts- und Schenkungssteuerverfahren Anwendung."
        },
        {
          "absatz": "2",
          "text": "Ausgleichszinsen werden frühestens ab 1. April 1989 berechnet."
        },
        {
          "absatz": "3",
          "text": "Nachsteuerzinsen werden nur bei den nach Inkrafttreten dieser Verordnung eingeleiteten Nachsteuerverfahren und frühestens ab 1. Januar 1987 erhoben."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "ac555f0cb19ec080688f32e7e1c413dab9f741f333b3fcfec22794bc11b02107",
      "sha": "1b5c2a7f030e9f7ca01f20b1d7f59bd793a60a4e21c45888917b231f2df65fd7"
    },
    {
      "id": "kanton/ZH/632.11/art_13",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung zum Erbschafts- und Schenkungssteuergesetz (LS 632.11)",
      "artikel": "13",
      "artikelLabel": "§ 13",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Verordnung tritt am 1. Januar 1987 in Kraft."
        }
      ],
      "stand": "2010-08-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-632_11-1986_11_12-1987_01_01-070.html",

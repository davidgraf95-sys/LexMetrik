      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-231_1-2004_12_01-2005_01_01-127.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "996c5ff6bd3ab6d0d17658992a1c0f6370236c3fecdb31bbbe456d8a79574207",
      "sha": "fffd896179b5a05de5123ab834ecf45024e7a99fc81a9e6dc269c8d0b54294f4"
    },
    {
      "id": "kanton/ZH/231.1/art_20_a",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Zivilstandsverordnung (ZVO) (LS 231.1)",
      "artikel": "20_a",
      "artikelLabel": "§ 20a",
      "bloecke": [
        {
          "absatz": null,
          "text": "Beschwerdeentscheide der kantonalen Aufsichtsbehörde (§ 12 a Abs. 2) gemäss Art. 90 Abs. 2 ZStV können mit Beschwerde beim Verwaltungsgericht angefochten werden."
        }
      ],
      "stand": "2025-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-231_1-2004_12_01-2005_01_01-127.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "996c5ff6bd3ab6d0d17658992a1c0f6370236c3fecdb31bbbe456d8a79574207",
      "sha": "9b8961bfce7cc39b3c4c287c2d863417c8f058d3cc62ae3e005d0fd60d250e01"
    },
    {
      "id": "kanton/ZH/231.1/art_21",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Zivilstandsverordnung (ZVO) (LS 231.1)",
      "artikel": "21",
      "artikelLabel": "§ 21",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Direktion lässt die Angaben des Anhangs zu dieser Verordnung nachführen, wenn die zu einem Zivilstandskreis zusammengefassten Gemeinden den Namen oder den Sitz des Zivilstandskreises ändern."
        }
      ],
      "stand": "2025-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-231_1-2004_12_01-2005_01_01-127.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "996c5ff6bd3ab6d0d17658992a1c0f6370236c3fecdb31bbbe456d8a79574207",
      "sha": "9e6ee3423cc46c840d1269ceacb7a13303734dc9852d0dfbad3718631208bed2"
    },
    {
      "id": "kanton/ZH/231.1/art_22",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Zivilstandsverordnung (ZVO) (LS 231.1)",
      "artikel": "22",
      "artikelLabel": "§ 22",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Zivilstandsverordnung vom 29. November 2000 wird aufgehoben."
        }
      ],
      "stand": "2025-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-231_1-2004_12_01-2005_01_01-127.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "996c5ff6bd3ab6d0d17658992a1c0f6370236c3fecdb31bbbe456d8a79574207",
      "sha": "76d7c0c71acf2f4c95493be8c2142fa90b81b1dce96659332dbd10a76218bc8b"
    },
    {
      "id": "kanton/ZH/231.1/art_23",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Zivilstandsverordnung (ZVO) (LS 231.1)",
      "artikel": "23",
      "artikelLabel": "§ 23",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Neben der vom Bundesrat vorgeschriebenen ereignisbezogenen Rückerfassung erfolgt eine systematische Rückerfassung und Überführung von Personendaten in die zentrale Datenbank Infostar."
        },
        {
          "absatz": "2",
          "text": "Die systematische Rückerfassung ist bis 31. Dezember 2012 für alle lebenden Personen abzuschliessen."
        },
        {
          "absatz": "3",
          "text": "In erster Priorität werden Personendaten aufgrund eines zivilstandsamtlichen Ereignisses oder aufgrund eines Rückerfassungsauftrages aus einem anderen Zivilstandskreis in das neue System übertragen."
        },
        {
          "absatz": "4",
          "text": "Die Zivilstandsämter erstatten jährlich Bericht an das Gemeindeamt über den Stand der Rückerfassung in ihrem Zivilstandskreis."
        }
      ],
      "stand": "2025-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-231_1-2004_12_01-2005_01_01-127.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "996c5ff6bd3ab6d0d17658992a1c0f6370236c3fecdb31bbbe456d8a79574207",
      "sha": "ac4f7f69bc45b820dacc028b8290d40e9ea8790fb530ad6bd0d7e26f866031de"
    },
    {
      "id": "kanton/ZH/231.1/art_24",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Zivilstandsverordnung (ZVO) (LS 231.1)",
      "artikel": "24",
      "artikelLabel": "§ 24",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Diese Verordnung tritt nach Genehmigung durch den Bund auf den 1. Januar 2005 in Kraft."
        },
        {
          "absatz": "2",
          "text": "§ 15 tritt mit Art. 22 und 43 Abs. 1–3 ZStV in Kraft."
        }
      ],
      "stand": "2025-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-231_1-2004_12_01-2005_01_01-127.html",

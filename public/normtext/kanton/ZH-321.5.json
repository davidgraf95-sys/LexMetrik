{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/321.5/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Hat eine Behörde in einem Strafverfahren das DNA-Profil einer Person erstellen lassen, gibt sie dies bei einer Verfahrensübergabe der übernehmenden Behörde bekannt."
        },
        {
          "absatz": "2",
          "text": "Für die Behandlung von Proben und DNA-Analysedaten, die im Rahmen einer Verfahrensübergabe nicht weitergegeben werden, bleibt die besitzende Behörde verantwortlich."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "df54d533b478fd8ded01c7a1f46d5e6d0e940006794289ff3c02bfc51220d004",
      "sha": "dd5474d51610724a99f3ce3e94ea7058bfa05e7366a6be819123d9d1812558c3"
    },
    {
      "id": "kanton/ZH/321.5/art_1_a",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "1_a",
      "artikelLabel": "§ 1a",
      "bloecke": [
        {
          "absatz": null,
          "text": "Zuständig für die Anordnung einer Erstellung eines DNA- Profils ausserhalb eines Strafverfahrens gemäss Art. 6 DNA-Profil- Gesetz sind die Polizei und die Staatsanwaltschaft."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "df54d533b478fd8ded01c7a1f46d5e6d0e940006794289ff3c02bfc51220d004",
      "sha": "c19df41f71cf300d35db3b3c41ff259799b448fe2287ce28b26993aa73474a35"
    },
    {
      "id": "kanton/ZH/321.5/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Als Polizei im Sinne dieser Verordnung und Art. 255 Abs. 2 der Schweizerischen Strafprozessordnung vom 5. Oktober 2007 gelten die Kantonspolizei Zürich sowie die Stadtpolizeien Zürich und Winterthur."
        },
        {
          "absatz": "2",
          "text": "Wird eine Probenahme angeordnet, erfolgt die Information der betroffenen Person gemäss Art. 15 Abs. 1 DNA-Profil-Gesetz im Auftrag der anordnenden Behörde durch die Behörde, welche die Probe nimmt."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "df54d533b478fd8ded01c7a1f46d5e6d0e940006794289ff3c02bfc51220d004",
      "sha": "3fd6c3228a5fbe319bead7967c749967abbfdbbc4a0da649ae8a8c634c96315a"
    },
    {
      "id": "kanton/ZH/321.5/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": null,
          "text": "Aufgehoben"
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",

    },
    {
      "id": "kanton/ZH/321.5/art_7",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die kantonale Koordinationsstelle für das Strafregister-Informationssystem VOSTRA ist die zentrale Stelle gemäss Art. 12 DNA- Profil-Verordnung."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "df54d533b478fd8ded01c7a1f46d5e6d0e940006794289ff3c02bfc51220d004",
      "sha": "b324300b9799c565e0a0e219eb441d1e438ca54e50f8e2c604bed831d49ae61a"
    },
    {
      "id": "kanton/ZH/321.5/art_8",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "8",
      "artikelLabel": "§ 8",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Polizei, die Staatsanwaltschaft, die Jugendanwaltschaft, das Gericht und die Vollzugsbehörde melden Löschungsereignisse mit dem Löschungsdatum innert 20 Tagen nach Eintritt des Ereignisses an die in § 7 bezeichnete Stelle."
        },
        {
          "absatz": "2",
          "text": "Zuständig ist jene Behörde, die als Letzte mit der Sache befasst war."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "df54d533b478fd8ded01c7a1f46d5e6d0e940006794289ff3c02bfc51220d004",
      "sha": "58225e0597295351bddebc968164ad79965fe5290e0ad4d51014f120206ffb76"
    },
    {
      "id": "kanton/ZH/321.5/art_9",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "9",
      "artikelLabel": "§ 9",
      "bloecke": [
        {
          "absatz": null,
          "text": "Ist eine der Voraussetzungen gemäss Art. 9 Abs. 1 DNA-Profil- Gesetz erfüllt, meldet die in diesem Zeitpunkt für das Verfahren zuständige Behörde dies der anordnenden Behörde."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "df54d533b478fd8ded01c7a1f46d5e6d0e940006794289ff3c02bfc51220d004",
      "sha": "816638f803e1c1f7871e431215689c58b1f6721a8c592d9b801263dfa0b0bb3c"
    },
    {
      "id": "kanton/ZH/321.5/art_10",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "10",
      "artikelLabel": "§ 10",
      "bloecke": [
        {
          "absatz": null,
          "text": "Diese Verordnung tritt mit Ausnahme von § 3 am 1. Juli 2005 in Kraft. Die Verordnung über die Erhebung und Bearbeitung von DNA-Analysen im Strafverfahren vom 18. April 2001 (DNA-Analysen- Verordnung) wird auf den gleichen Zeitpunkt aufgehoben. Anhang zu § 8"
        }
      ],
      "stand": "2024-10-01",

      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "df54d533b478fd8ded01c7a1f46d5e6d0e940006794289ff3c02bfc51220d004",
      "sha": "fffd896179b5a05de5123ab834ecf45024e7a99fc81a9e6dc269c8d0b54294f4"
    },
    {
      "id": "kanton/ZH/321.5/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "DNA-Verordnung (DNAV) (LS 321.5)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": null,
          "text": "Als tatortberechtigte Mitarbeiterinnen und Mitarbeiter im Sinne von Art. 11 Abs. 1 DNA-Profil-Verordnung gelten",
          "items": [
            {
              "marke": "a",
              "text": "die von der Leitung des Instituts für Rechtsmedizin der Universität Zürich bezeichneten Personen,"
            },
            {
              "marke": "b",
              "text": "die von den jeweiligen Kommandos bezeichneten Angehörigen der Kantonspolizei sowie der Stadtpolizeien Zürich und Winterthur,"
            },
            {
              "marke": "c",
              "text": "die von der Oberstaatsanwaltschaft und der Oberjugendanwaltschaft bezeichneten Angehörigen der Strafuntersuchungsbehörden,"
            },
            {
              "marke": "d",
              "text": "die von der Leitung des Forensischen Instituts Zürich bezeichneten Mitarbeitenden."
            }
          ]
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_5-2005_06_08-2005_07_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "df54d533b478fd8ded01c7a1f46d5e6d0e940006794289ff3c02bfc51220d004",
      "sha": "ed1ee7208c31622e4aafabe65e903e529604cab3b5eef08b718e52faab85d9bc"
    },

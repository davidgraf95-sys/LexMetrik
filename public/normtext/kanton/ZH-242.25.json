{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/242.25/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Notariatsverwaltung umfasst die Führung im Notariatswesen, insbesondere die Bereiche Finanzwesen, Personalwesen, Einrichtung der Amtsräume, Anschaffung und Unterhalt von Bürogeräten und Mittel der Informatik sowie die Vorsorge für eine ordnungsgemässe Geschäftsabwicklung der Notariate."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "2e447470fb3d41957d6bd0ee411c127ee7691868c611dbe1c6416162e21f8924"
    },
    {
      "id": "kanton/ZH/242.25/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Notariatsverwaltung wird von der Verwaltungskommission, vom Notariatsinspektorat, der erweiterten Geschäftsleitung und vom Notariat ausgeübt, soweit sie nicht dem Obergericht als Gesamtbehörde vorbehalten ist."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "dce14f441f95c9d16cc181815af66438be990394f828e66bca932ee38d23195a"
    },
    {
      "id": "kanton/ZH/242.25/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Notariatsinspektorat besorgt für die Verwaltungskommission des Obergerichts die Geschäftsleitung des Notariatswesens in den Bereichen Aufsicht und Verwaltung, soweit es hiezu in dieser Verordnung ermächtigt ist."
        },
        {
          "absatz": "2",
          "text": "Es bereitet die in die Zuständigkeit der Verwaltungskommission fallenden Geschäfte vor, soweit sie das Notariatswesen betreffen, und stellt in der Regel Antrag."
        },
        {
          "absatz": "3",
          "text": "Es kann mit den Notariaten die Kontrakte abschliessen, durch welche das Globalbudget auf die einzelnen Ämter übertragen wird."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "aa549751fc74a495ab2c6878d92944a09719dfcbe02e8e4568c58b64b50eade7"
    },
    {
      "id": "kanton/ZH/242.25/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Den Notariaten obliegt die Notariatsverwaltung in den ihnen durch diese Verordnung zugewiesenen Bereichen und der ihnen übertragenen Kompetenzen."
        },
        {
          "absatz": "2",
          "text": "Soweit diese Verordnung einzelne Verwaltungsbefugnisse dem Notariat zuweist, obliegen sie dem Notar oder der Notarin."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "3082cb770cae86a5d8f5cdd8d67c7a7e003453527cc2130f90f64bbcf68461ea"
    },
    {
      "id": "kanton/ZH/242.25/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat bereitet zuhanden der Verwaltungskommission den Voranschlag, die Jahresrechnung und die erforderlichen Planungsgrundlagen für das Notariatswesen vor."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "c85ff06d784c590129fb4d547ea6cfcbbb7f38eedb5e00c56966d1b235817687"
    },
    {
      "id": "kanton/ZH/242.25/art_6",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "6",
      "artikelLabel": "§ 6",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat überwacht das gesamte Gebührenund Rechnungswesen und ist für die Einhaltung der für das Notariatswesen bewilligten Kredite sowie für einen wirkungsvollen Einsatz der zur Verfügung stehenden Mittel verantwortlich."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "3598a0fabb8d165789db583dd38ea2690814a2987e5aa7407935de90a4f7b082"
    },
    {
      "id": "kanton/ZH/242.25/art_7",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Ausgabenkompetenz des Notariatsinspektorates richtet sich nach den Bestimmungen der Verordnung über die Organisation des Obergerichtes."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "2f1896d19c3f638452e9cec7d8e1dbf106e624064e68f8a9da6b37c0fddcb9dc"
    },
    {
      "id": "kanton/ZH/242.25/art_8",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "8",
      "artikelLabel": "§ 8",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Notariate verfügen im Rahmen der ihnen zugewiesenen Kompetenzen über den ihnen bewilligten Voranschlag."
        },
        {
          "absatz": "2",
          "text": "Sie sind für die ordnungsgemässe Rechnungsführung und für die Einhaltung der ihnen im Rahmen der Kontrakte zur Verfügung stehenden Mittel sowie für den wirkungsvollen Einsatz derselben verantwortlich."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "a9ec43749979e0bc58bd6662f4e35e8b13f61e870508af45a435ef68eca40baa"
    },
    {
      "id": "kanton/ZH/242.25/art_9",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "9",
      "artikelLabel": "§ 9",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Verwaltungskommission bestimmt die im Personalwesen einzuhaltenden Richtlinien. Sie legt die für den Stellenplan im Notariatswesen massgebende Gesamtpunktzahl fest und übt die Aufsicht über den Stellenplan aus."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "c36d411cb4dc3781c711e08800752ce313214c8aa261cfb1f5869c7c2dbd9326"
    },
    {
      "id": "kanton/ZH/242.25/art_10",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "10",
      "artikelLabel": "§ 10",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Notariatsinspektorat ist zuständig zur Festsetzung, Änderung und Bearbeitung der Stellenpläne für das Notariatsinspektorat und für die einzelnen Notariate."
        },
        {
          "absatz": "2",
          "text": "Es erstattet der Verwaltungskommission periodisch Bericht über den Stellenplan und dessen Auslastung."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "49ad3b8a6393d2d8ae4588f86485b5c32a432d0335f017ce30eab91547053d40"
    },
    {
      "id": "kanton/ZH/242.25/art_11",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "11",
      "artikelLabel": "§ 11",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat ist Anstellungsbehörde bezüglich seiner eigenen Angestellten sowie der Notar-Stellvertreter und Notar- Stellvertreterinnen der Notariate."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "139d191050674fe7ae0ac16def18ab25bf55a65dd5843588a60ac43f672fe237"
    },
    {
      "id": "kanton/ZH/242.25/art_12",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "12",
      "artikelLabel": "§ 12",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Notariat ist im Rahmen des Stellenplanes Anstellungsbehörde für die übrigen Angestellten."
        },
        {
          "absatz": "2",
          "text": "Das Notariatsinspektorat kann den Notariaten im Rahmen der zur Verfügung stehenden Mittel die Anstellung von Personal ausserhalb des Stellenplans für das einzelne Notariat bewilligen."
        },
        {
          "absatz": "3",
          "text": "Für die Gewährung von Zulagen gemäss §§ 25, 26 Abs. 1–3 und 27 Personalverordnung ist das Einvernehmen mit dem Notariatsinspektorat erforderlich."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "190da1f6401ee94f57c2d66dabdf588b746b147e0473bad8c68bda01ea3d2de1"
    },
    {
      "id": "kanton/ZH/242.25/art_13",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "13",
      "artikelLabel": "§ 13",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat erteilt die erweiterten Befugnisse im Sinne von § 13 ff. NotG an Mitarbeiterinnen und Mitarbeiter."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "758f9f74c3c9885c04bb0d91b959f08aafb7f0b1d112f588072edc70e081f016"
    },
    {
      "id": "kanton/ZH/242.25/art_14",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "14",
      "artikelLabel": "§ 14",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat führt zentrale Ausbildungskurse für die Lehrlinge und Lehrtöchter sowie Weiterbildungskurse für die Mitarbeiterinnen und Mitarbeiter durch."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "d59334a0ed7083a9f04092ec38681d500e7e7cf7034bf1043638630429c3955c"
    },
    {
      "id": "kanton/ZH/242.25/art_15",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "15",
      "artikelLabel": "§ 15",
      "bloecke": [
        {
          "absatz": null,
          "text": "Dem Notariat obliegt mit Unterstützung des Notariatsinspektorates die Personalplanung, die Personalrekrutierung und die Personalbetreuung."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "0fdde62a209bfc105d96f129d074893d3fda5bde9998c334c7bf52566b5caef5"
    },
    {
      "id": "kanton/ZH/242.25/art_16",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "16",
      "artikelLabel": "§ 16",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat überwacht die Einhaltung der Anstellungs-, Einreihungs- und Beförderungsgrundsätze durch die Notariate und koordiniert deren Praxis. Es erlässt ergänzende verbindliche Richtlinien."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "e914ee803b3f342fe6c353212e7ad8e16816b6b6d4e5ae3e72d01b3c60a962b7"
    },
    {
      "id": "kanton/ZH/242.25/art_17",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "17",
      "artikelLabel": "§ 17",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Notariatsinspektorat plant und entwickelt organisatorische, administrative und technische Hilfsmittel für die Personalführung. Es führt ein zentrales Personalinformationssystem."
        },
        {
          "absatz": "2",
          "text": "Es legt das fiktive Eintrittsdatum der Notare, Notarinnen und des übrigen Personals fest."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "8c4fff9ef347ee86b1d9efee71bdcbe76247f0b59466d0a5193943fd7166b044"
    },
    {
      "id": "kanton/ZH/242.25/art_18",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "18",
      "artikelLabel": "§ 18",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat ist zuständig für die Versetzung von Angestellten auf ein anderes Notariat (§ 28 Personalgesetz)."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "2b44c878a0e9e3106e905118d11ec8f9f83703077b2d104353f617df307d2a54"
    },
    {
      "id": "kanton/ZH/242.25/art_19",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "19",
      "artikelLabel": "§ 19",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Anordnung von vorsorglichen Massnahmen und die Erteilung eines Verweises gegenüber einem Notar oder einer Notarin, einem Notar-Stellvertreter oder einer Notar-Stellvertreterin obliegt der Verwaltungskommission, gegenüber den übrigen Angestellten dem Notariatsinspektorat (§ 29 Personalgesetz)."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "28c14af8558146026af0698d7348818ab6dd68b938ed5ce1e8a2fd643cb55b59"
    },
    {
      "id": "kanton/ZH/242.25/art_20",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "20",
      "artikelLabel": "§ 20",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat trifft die erforderlichen Massnahmen bei vorübergehender Überlastung eines Amtes oder bei länger dauernden Vakanzen."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "feffb043715c1e5b776d97380537383f137f2d8b959a3b1e3d9060d9ed88705c"
    },
    {
      "id": "kanton/ZH/242.25/art_21",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "21",
      "artikelLabel": "§ 21",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat trifft im Zusammenhang mit Amtsübergaben die erforderlichen Anordnungen."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "61bbac4c086549b5ec8d5bb68303fe95d41a2262c245ccec5717374109c2ba62"
    },
    {
      "id": "kanton/ZH/242.25/art_22",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "22",
      "artikelLabel": "§ 22",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Mietverträge werden vom Notariatsinspektorat abgeschlossen, welches auch über die Einteilung der Amtsräume bestimmt."
        },
        {
          "absatz": "2",
          "text": "Die Miete von Amtsräumen bedarf der Zustimmung der Verwaltungskommission."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "c56ddf0c13641487c48f665e46fdaa4106bf0e41969f3f9a6fa9532b8b7529e4"
    },
    {
      "id": "kanton/ZH/242.25/art_23",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "23",
      "artikelLabel": "§ 23",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariat pflegt den Kontakt mit der Vermieterschaft und besorgt den baulichen Unterhalt im Rahmen der ihm zugewiesenen Mittel."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "b1d8e44968f64f0c8ba8e9d5bc8371375282f5f18115e8509247ea5010667991"
    },
    {
      "id": "kanton/ZH/242.25/art_24",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "24",
      "artikelLabel": "§ 24",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat leitet und koordiniert die Informatikprojekte im Notariatswesen und stellt der Verwaltungskommission Antrag auf Beschaffung der Informatikmittel (Hardware und Software), soweit es dazu nicht in eigener Kompetenz ermächtigt ist."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "2a1f4dac15b9cfb28a221ce68180e8e1c090af51b2446f30a86b0761485b8d3e"
    },
    {
      "id": "kanton/ZH/242.25/art_25",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "25",
      "artikelLabel": "§ 25",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Notariate beschaffen Mobiliar und Büromaschinen im Rahmen der ihnen zur Verfügung stehenden Mittel und der bestehenden Richtlinien."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "b43fb6d01a9e79fdbabbdebf1c006e6e076c3cd719bb44918ab29ab5f23391b2"
    },
    {
      "id": "kanton/ZH/242.25/art_26",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "26",
      "artikelLabel": "§ 26",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Notariate sind für die ordnungsgemässe Erfüllung der ihnen übertragenen Aufgaben verantwortlich."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "dd3adbbe133c9897c0737a917600694c1b0a8e39646cb59bd9a1748f41708970"
    },
    {
      "id": "kanton/ZH/242.25/art_27",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "27",
      "artikelLabel": "§ 27",
      "bloecke": [
        {
          "absatz": null,
          "text": "Dem Notar oder der Notarin obliegt die Führung des Amtes. Er oder sie erfüllt die Führungsaufgaben unter Einsatz der Persönlichkeit, fördert die Angestellten und setzt sie ihren Fähigkeiten und Funktionen entsprechend ein."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "20a9348244bc174422b3057abcb5e47f189313ce7f1b3763f6a1f0a006cc8f33"
    },
    {
      "id": "kanton/ZH/242.25/art_28",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "28",
      "artikelLabel": "§ 28",
      "bloecke": [
        {
          "absatz": null,
          "text": "Dem Notariatsinspektorat steht ein Geschäftsleiter oder eine Geschäftsleiterin vor. Die Stellvertretung wird von einem Notariatsinspektor oder von einer Notariatsinspektorin ausgeübt. Bei mehreren bestimmt die Verwaltungskommission die Stellvertretung."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "94ac88893b692d23a0df713a18f0bb7a5849965a8ae99d6738efbd4067ff8a0f"
    },
    {
      "id": "kanton/ZH/242.25/art_29",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "29",
      "artikelLabel": "§ 29",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Notariatsinspektorat inspiziert in der Regel einmal jährlich jedes seiner Aufsicht unterstehende Amt."
        },
        {
          "absatz": "2",
          "text": "Es erstattet der Verwaltungskommission schriftlichen Bericht."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "0508b77d539261dbdf019518a86a64c6b8fcd0edf364867b544fe4ce928dbc4b"
    },
    {
      "id": "kanton/ZH/242.25/art_30",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "30",
      "artikelLabel": "§ 30",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Notariatsinspektorat kann den Ämtern im Einzelfall, insbesondere im Zusammenhang mit Inspektionen, verbindliche Anweisungen, auch über die Rechtsanwendung, erteilen und Auflagen machen oder der Verwaltungskommission entsprechende Anträge stellen."
        },
        {
          "absatz": "2",
          "text": "Der Erlass allgemeiner Dienstanweisungen in der Form von Kreisschreiben und Reglementen ist der Verwaltungskommission vorbehalten."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "4abfefea4853dabedb9859d62111821861d1f863888009e9db19efdfd041a928"
    },
    {
      "id": "kanton/ZH/242.25/art_31",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "31",
      "artikelLabel": "§ 31",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Notariatsinspektorat erstattet der Verwaltungskommission jährlich Bericht über die Geschäftslast, die Geschäftsführung, die Personalsituation, die finanzielle Entwicklung, über den Stand der Grundbucheinführung und über die Tätigkeit des Notariatsinspektorates."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "6fc67796bf3f4c0a75291b66a50c5b9e0f8f451eed1856b6736bab475542ed94"
    },
    {
      "id": "kanton/ZH/242.25/art_32",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "32",
      "artikelLabel": "§ 32",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Dem Notariatsinspektorat ist eine erweiterte Geschäftsleitung beigegeben. Sie besteht aus dem Geschäftsleiter oder der Geschäftsleiterin des Notariatsinspektorates und dessen bzw. deren Stellvertretung sowie aus fünf Notaren oder Notarinnen. Weitere Notariatsinspektoren oder -innen nehmen an Sitzungen mit beratender Stimme teil. Der Geschäftsleiter oder die Geschäftsleiterin führt den Vorsitz."
        },
        {
          "absatz": "2",
          "text": "Die fünf Notare oder Notarinnen werden von der Verwaltungskommission auf eine Amtsdauer von zwei Jahren gewählt. Eine zweimalige Wiederwahl ist zulässig."
        },
        {
          "absatz": "3",
          "text": "Die Notare und Notarinnen können der Verwaltungskommission Wahlvorschläge unterbreiten."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "b0d6ef7ec276e759d33decf5fe77263580ec24a8c868e8ee11bf0050eb956ae4"
    },
    {
      "id": "kanton/ZH/242.25/art_33",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "33",
      "artikelLabel": "§ 33",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Sekretariat der erweiterten Geschäftsleitung wird vom Notariatsinspektorat besorgt."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "f759c0ad3589b841504a89cf7c7544d7249b5bae6cdaff39cefd31d108a8e906"
    },
    {
      "id": "kanton/ZH/242.25/art_34",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "34",
      "artikelLabel": "§ 34",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die erweiterte Geschäftsleitung ist beschlussfähig, wenn drei Notare oder Notarinnen und der Geschäftsleiter oder die Geschäftsleiterin des Notariatsinspektorates oder dessen bzw. deren Stellvertretung anwesend sind. Die Beschlüsse werden mit einfacher Mehrheit der Stimmen der anwesenden Mitglieder gefasst."
        },
        {
          "absatz": "2",
          "text": "Kommt ein Beschluss nicht einstimmig zustande, können zwei Mitglieder der erweiterten Geschäftsleitung verlangen, dass das Geschäft der Verwaltungskommission zum Entscheid unterbreitet wird."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "a63ef963f64df05633f949ea73024f2d2a6a7487a6ce411dd7c8e43c45c148fe"
    },
    {
      "id": "kanton/ZH/242.25/art_35",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "35",
      "artikelLabel": "§ 35",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die erweiterte Geschäftsleitung wird wenigstens zweimal jährlich durch das Notariatsinspektorat oder auf Antrag von drei Notariatsvertretern zu Sitzungen einberufen."
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "d76f579730d497c8d4c68dc5d7f40a2829f31cd28218c60754a3f99d794372fe"
    },
    {
      "id": "kanton/ZH/242.25/art_36",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "36",
      "artikelLabel": "§ 36",
      "bloecke": [
        {
          "absatz": null,
          "text": "Der erweiterten Geschäftsleitung obliegen:",
          "items": [
            {
              "marke": "a",
              "text": "Festlegung der Führungsinstrumente für das Notariatswesen,"
            },
            {
              "marke": "b",
              "text": "Festlegung des Stellenplans für das gesamte Notariatswesen im Rahmen der vorgegebenen Gesamtpunktzahl und der Erlass von Grundsätzen für die Festlegung der Stellenpläne für die einzelnen Notariate durch das Notariatsinspektorat,"
            },
            {
              "marke": "c",
              "text": "Festlegung der Grundsätze zur Förderung des Personals und der Instrumente zur Auswahl und zur Förderung des fachlichen Nachwuchses,"
            },
            {
              "marke": "d",
              "text": "Erhebung der Kunden- und Mitarbeiterzufriedenheit,"
            },
            {
              "marke": "e",
              "text": "Formulierung des Leistungsauftrags und Erlass der Grundsätze über die Kontrakte,"
            },
            {
              "marke": "f",
              "text": "Erlass der Grundsätze für die bauliche Ausgestaltung der Notariate,"
            },
            {
              "marke": "g",
              "text": "Stellungnahme zu fachlichen Arbeitshilfen und im Formularwesen,"
            },
            {
              "marke": "h",
              "text": "Stellungnahme zu den der Verwaltungskommission oder dem Gesamtobergericht zustehenden grundsätzlichen Anordnungen, generelle Weisungen, Informatikstrategie, Kompetenzordnungen im Notariatswesen, Festlegung der Richtpositionen und weitere Anordnungen im Personalwesen sowie zur Änderung bestehender oder zum Erlass neuer gesetzlicher Erlasse,"
            },
            {
              "marke": "i",
              "text": "Erledigung der von der Verwaltungskommission oder dem Notariatsinspektorat unterbreiteten Angelegenheiten,"
            },
            {
              "marke": "k",
              "text": "Erlass einer Geschäftsordnung für die erweiterte Geschäftsleitung."
            }
          ]
        }
      ],
      "stand": "2016-07-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242_25-1999_12_08-2001_01_01-093.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "be188af001aa2cebb4dcac4fdbf3b206c436ba00a166add376203c1de37ca0d1",
      "sha": "6ff9e9ecfe882289f05d2350ad0ef4db573f47040629f5109b94e77833f1e367"
    },
    {
      "id": "kanton/ZH/242.25/art_37",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Verordnung über die Notariatsverwaltung (Notariatsverwaltungsverordnung) (LS 242.25)",
      "artikel": "37",
      "artikelLabel": "§ 37",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Diese Verordnung tritt gleichzeitig mit der Verordnung über die Organisation des Obergerichts vom 8. Dezember 1999 in Kraft. Sie ist im Amtsblatt und in der Gesetzessammlung zu veröffentlichen."
        },
        {
          "absatz": "2",
          "text": "Gleichzeitig wird die Verordnung über die Notariatsverwaltung vom 14. Dezember 1988 aufgehoben."
        }
      ],
      "stand": "2016-07-01",

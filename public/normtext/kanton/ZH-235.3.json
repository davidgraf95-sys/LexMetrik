      "erlass": "Einführungsgesetz zum Bundesgesetz über Rahmenmietverträge und deren Allgemeinverbindlicherklärung (LS 235.3)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": null,
          "text": "Über die Allgemeinverbindlicherklärung von Rahmenmietverträgen, die für das Gebiet des Kantons oder eines Teils davon Geltung haben, entscheidet der Regierungsrat."
        }
      ],

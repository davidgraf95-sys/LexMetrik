{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/242/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Dem Notariat obliegen:",
          "items": [
            {
              "marke": "a",
              "text": "die notariellen Aufgaben, wie"
            },
            {
              "marke": "1",
              "text": "die Errichtung öffentlicher Urkunden über Willenserklärungen, für welche diese Form nach Gesetz erforderlich ist oder von den Parteien gewünscht wird, über Tatbestände und Vorgänge sowie über rechtliche Verhältnisse, soweit diese Aufgabe nicht in die ausschliessliche Zuständigkeit einer andern Amtsstelle fällt;"
            },
            {
              "marke": "2",
              "text": "die Beglaubigungen;"
            },
            {
              "marke": "3",
              "text": "die Aufbewahrung der zu diesem Zweck übergebenen Verfügungen von Todes wegen;"
            },
            {
              "marke": "4",
              "text": "die Mitwirkung in erbrechtlichen Sachen im Auftrag des Richters;"
            },
            {
              "marke": "b",
              "text": "die Aufgaben des Grundbuchamtes, insbesondere die Anlegung und die Führung des Grundbuchs, der kantonalen übergangsrechtlichen Grundbucheinrichtungen und des Verzeichnisses über die Korporationsteilrechte sowie die Durchführung des Sühneverfahrens in Streitigkeiten, die sich bei der Anlegung des Grundbuchs über dingliche Rechte ergeben;"
            },
            {
              "marke": "c",
              "text": "die Aufgaben des Konkursamtes;"
            },
            {
              "marke": "d",
              "text": "weitere Aufgaben, die das Gesetz oder eine vom Gesetz ermächtigte Behörde den Notariaten überträgt."
            }
          ]
        },
        {
          "absatz": "2",
          "text": "Aufgaben, welche die Gesetzgebung dem Notar, Grundbuchverwalter oder Konkursbeamten zuweist, obliegen dem Notariat."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "7996f8bf317d2252d32d657111f58f87b8939c13b1623b2c17dfee3542b5820a"
    },
    {
      "id": "kanton/ZH/242/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Kanton wird in Notariatskreise eingeteilt."
        },
        {
          "absatz": "2",
          "text": "Ein Notariatskreis umfasst in der Regel mehrere, nach Möglichkeit im gleichen Bezirk liegende Gemeinden."
        },
        {
          "absatz": "3",
          "text": "Für die Städte Zürich und Winterthur können mehrere Notariatskreise gebildet werden. Die Einteilung erfolgt nach Stadtquartieren. Diesen Kreisen können auch andere Gemeinden zugewiesen werden."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "a74ac58a4395fab931586ed11d7e9d555f14275238a9847745a67ee57e44c079"
    },
    {
      "id": "kanton/ZH/242/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Obergericht bezeichnet für jedes Notariat ein benachbartes Notariat als stellvertretendes Amt."
        },
        {
          "absatz": "2",
          "text": "Das Obergericht kann die Stellvertretung anders ordnen, insbesondere bei längerdauernder Verhinderung oder bei Tod eines Notars sowie bei vorübergehender Überlastung eines Notariats."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "14e6e624319870e4c270042c41d75c91c9701c45aa7f5156e8d8ff764661c5fd"
    },
    {
      "id": "kanton/ZH/242/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die örtliche Zuständigkeit der Notariate richtet sich nach den für die Erfüllung der betreffenden Aufgabe massgebenden Bestimmungen."
        },
        {
          "absatz": "2",
          "text": "Der Kantonsrat regelt die Zuständigkeit, wenn sie nicht nach Abs. 1 bestimmt ist."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "158951e183aed834a5f5277f613b1595b654a7fdc4e667a10ef0e9b2495eb21d"
    },
    {
      "id": "kanton/ZH/242/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": null,
          "text": "Durch eidgenössisches oder kantonales Recht können besondere Aufgaben bestimmten Notariaten zugewiesen werden."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "dec6a56408c8e89263c70eacc44ab0ef028fc417f72ebb9f1d18f1f7a2588505"
    },
    {
      "id": "kanton/ZH/242/art_6",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "6",
      "artikelLabel": "§ 6",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Ausbildung zum Notar erfolgt über eine Lehre oder Mittelschule oder über ein Studium."
        },
        {
          "absatz": "2",
          "text": "Die Ausbildung über Lehre oder Mittelschule umfasst:",
          "items": [
            {
              "marke": "a",
              "text": "eine erfolgreich abgeschlossene kaufmännische Lehre oder Mittelschule;"
            },
            {
              "marke": "b",
              "text": "eine mehrjährige praktische Tätigkeit nach Lehr- oder Mittelschulabschluss auf einem zürcherischen Notariat;"
            },
            {
              "marke": "c",
              "text": "ein auf die Prüfungsfächer bezogenes Teilstudium an einer schweizerischen Hochschule."
            }
          ]
        },
        {
          "absatz": "3",
          "text": "Die Ausbildung über ein Studium umfasst:",
          "items": [
            {
              "marke": "a",
              "text": "ein erfolgreich abgeschlossenes Studium der Rechtswissenschaft an einer schweizerischen Hochschule;"
            },
            {
              "marke": "b",
              "text": "eine praktische Tätigkeit auf einem zürcherischen Notariat, deren Dauer jener gemäss Abs. 2 lit. b entspricht."
            }
          ]
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "6704047129ca2122e5b42d5a888316fd96e77213332b96ea9a3f8bdb18bc4246"
    },
    {
      "id": "kanton/ZH/242/art_7",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Nach der Ausbildung werden handlungsfähige, vertrauenswürdige Schweizer Bürger auf Gesuch zur Fähigkeitsprüfung zugelassen."
        },
        {
          "absatz": "2",
          "text": "Die Fähigkeitsprüfung wird unter Aufsicht des Obergerichtes durch eine von ihm gewählte Prüfungskommission abgenommen. Sie erstreckt sich auf die zur Erfüllung der Aufgaben des Notars erforderlichen Kenntnisse und Fähigkeiten."
        },
        {
          "absatz": "3",
          "text": "Nach bestandener Prüfung erhält der Bewerber einen Fähigkeitsausweis, der ihn berechtigt, für eine bestimmte Zeit auf einem zürcherischen Notariat als Notar-Stellvertreter tätig zu sein."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "2e45a8cc8e33d228af3fe86a90d4bebf647464afd0a89b0e6f5126d72d728f30"
    },
    {
      "id": "kanton/ZH/242/art_8",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "8",
      "artikelLabel": "§ 8",
      "bloecke": [
        {
          "absatz": null,
          "text": "Dem Bewerber, der sich während zwei Jahren als Notar- Stellvertreter auf einem zürcherischen Notariat bewährt hat, wird vom Obergericht das Wahlfähigkeitszeugnis als Notar erteilt."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "394df3d49976f479a9d87a59ea94e80f2a141674fe698b1515260853c560daa5"
    },
    {
      "id": "kanton/ZH/242/art_9",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "9",
      "artikelLabel": "§ 9",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Obergericht entzieht dem Inhaber den Fähigkeitsausweis oder das Wahlfähigkeitszeugnis vorübergehend oder dauernd, wenn er die Handlungsfähigkeit oder die Vertrauenswürdigkeit verliert."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "3a991673b76144e635a66816fe09e90c5b55b0b4eaca3fa2302a94e2c504668d"
    },
    {
      "id": "kanton/ZH/242/art_10",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "10",
      "artikelLabel": "§ 10",
      "bloecke": [
        {
          "absatz": null,
          "text": "Der Notar wird von den Stimmberechtigten des Notariatskreises aus den Bewerbern gewählt, die das Wahlfähigkeitszeugnis besitzen."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "a0beadb69f3130892334ba9997a76026e7a0da542fbd56aed290523883d60e05"
    },
    {
      "id": "kanton/ZH/242/art_11",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "11",
      "artikelLabel": "§ 11",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Notar leitet das Notariat."
        },
        {
          "absatz": "2",
          "text": "Er nimmt die Amtshandlungen vor, soweit er sie nicht einem Mitarbeiter überträgt."
        },
        {
          "absatz": "3",
          "text": "Der Notar ist für eine zweckmässige Arbeitsorganisation besorgt, beaufsichtigt seine Mitarbeiter und erteilt ihnen die für eine geordnete Amtsführung erforderlichen Anweisungen. Er vertritt das Notariat gegenüber den vorgesetzten Behörden und nach aussen."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "756a90563795223c8e6c187f1d3c0ea33c23c7f2e9f53ce2cbb109f7c52335cb"
    },
    {
      "id": "kanton/ZH/242/art_12",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "12",
      "artikelLabel": "§ 12",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Obergericht bewilligt den Notariaten die erforderlichen Notar-Stellvertreter."
        },
        {
          "absatz": "2",
          "text": "Als Notar-Stellvertreter kann angestellt werden, wer das Wahlfähigkeitszeugnis besitzt oder einen Fähigkeitsausweis, der zur Ausübung dieser Funktion berechtigt."
        },
        {
          "absatz": "3",
          "text": "Der Notar-Stellvertreter ist befugt, alle einem Notar obliegenden Amtshandlungen vorzunehmen. Seine Verfügungen sind solchen des Notars gleichgestellt."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "a1617d82b9b11aa4cd58fc0e4d385c31cb9e9380121169c651184912a827f3b6"
    },
    {
      "id": "kanton/ZH/242/art_13",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "13",
      "artikelLabel": "§ 13",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Obergericht kann Angestellte ermächtigen",
          "items": [
            {
              "marke": "a",
              "text": "zur Aufnahme von Wechselprotesten;"
            },
            {
              "marke": "b",
              "text": "zur Beurkundung von Rechtsgeschäften über dingliche und vormerkbare Rechte an Grundstücken;"
            },
            {
              "marke": "c",
              "text": "zu Beglaubigungen."
            }
          ]
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "6e1dfd8ea7ced331c2077f1a60c23099a77bba5bd45b44076bf9037700c9e21f"
    },
    {
      "id": "kanton/ZH/242/art_14",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "14",
      "artikelLabel": "§ 14",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Obergericht kann Angestellte zur Anlegung und Führung des Grundbuchs sowie der kantonalen übergangsrechtlichen Grundbucheinrichtungen und des Verzeichnisses über die Korporationsteilrechte ermächtigen."
        },
        {
          "absatz": "2",
          "text": "Die Abweisung von Grundbuchanmeldungen und die Unterzeichnung von Schuldbriefen sind den Notaren und den Notar-Stellvertretern vorbehalten."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "9b0a5a4b7c22eeafa8e839bad6e5e622efa368462f93e2efd78095fb16486641"
    },
    {
      "id": "kanton/ZH/242/art_15",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "15",
      "artikelLabel": "§ 15",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Obergericht kann Angestellte ermächtigen, Konkursinventare aufzunehmen und Zwangsversteigerungen durchzuführen."
        },
        {
          "absatz": "2",
          "text": "Die Zwangsversteigerung von Grundstücken bleibt den Notaren und Notar-Stellvertretern vorbehalten."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "5213de5e3827a1c44e106194d3af5981a541b50dabae8f037881b5c24c4ed0a7"
    },
    {
      "id": "kanton/ZH/242/art_16",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "16",
      "artikelLabel": "§ 16",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Erteilung erweiterter Befugnisse setzt ausreichende Ausbildung und Erfahrung voraus. Sie kann vom erfolgreichen Besuch von Fachkursen oder vom Bestehen einer Fachprüfung abhängig gemacht werden."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "79a39ad2a31e3deba338969f41f856e2d0409dd08b49ec9dcdbc0e3a75809520"
    },
    {
      "id": "kanton/ZH/242/art_17",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "17",
      "artikelLabel": "§ 17",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Notariate bilden Lehrlinge zu kaufmännischen Angestellten mit entsprechender Fachausbildung aus."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "3b8fd2a9bdbfa0d571e2843087966ab0b897c9bd0f4c529ffc4ec61762becffd"
    },
    {
      "id": "kanton/ZH/242/art_18",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "18",
      "artikelLabel": "§ 18",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Notare und ihre Mitarbeiter unterstehen dem kantonalen Personalrecht."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "9fff2b3b8f5554ca28181196d54e39ffb81b0cbd90dd1659f52cc8dec2b63d88"
    },
    {
      "id": "kanton/ZH/242/art_19",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "19",
      "artikelLabel": "§ 19",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Anstellung der Notar-Stellvertreter und der übrigen Mitarbeiter erfolgt auf Antrag des Notars durch das Obergericht."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "2617784d59c1862d8314db31e940e206fc7affdb3c797fa88cd808b7b92dab10"
    },
    {
      "id": "kanton/ZH/242/art_20",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "20",
      "artikelLabel": "§ 20",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Notar darf keine Amtshandlung vornehmen, wenn von der Sache betroffen sind:",
          "items": [
            {
              "marke": "a",
              "text": "er selbst;"
            },
            {
              "marke": "b",
              "text": "Ehegatte; Verlobte; eingetragener Partner; eine Person, mit der er in faktischer Lebensgemeinschaft lebt; bis zum dritten Grad Verwandte und Verschwägerte;"
            },
            {
              "marke": "c",
              "text": "mit ihm im gemeinsamen Haushalt lebende Personen;"
            },
            {
              "marke": "d",
              "text": "eine von ihm vertretene Person;"
            },
            {
              "marke": "e",
              "text": "eine Personenverbindung ohne Rechtspersönlichkeit, an welcher er beteiligt ist;"
            },
            {
              "marke": "f",
              "text": "eine juristische Person, sofern er einem ihrer Organe angehört oder an ihr finanziell massgeblich beteiligt ist."
            }
          ]
        },
        {
          "absatz": "2",
          "text": "Die gleichen Ausstandsgründe gelten für seine Mitarbeiter."
        },
        {
          "absatz": "3",
          "text": "In allen Fällen, in denen der Notar im Ausstand ist, dürfen auch seine Mitarbeiter nicht tätig sein."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "fce6519da4c474d91e3b2898d36363093770d67124078f1d57fdb9cc07d1d426"
    },
    {
      "id": "kanton/ZH/242/art_21",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "21",
      "artikelLabel": "§ 21",
      "bloecke": [
        {
          "absatz": null,
          "text": "Dem Notar und seinen Mitarbeitern sind der Handel mit Grundstücken und Schuldbriefen sowie die Vermittlung von Grundstücken verboten."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "01df799dc8da69a4c1865f3b85f055099643cf67ec3c8b8d2d92092a9282e564"
    },
    {
      "id": "kanton/ZH/242/art_22",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "22",
      "artikelLabel": "§ 22",
      "bloecke": [
        {
          "absatz": null,
          "text": "Ordnungsstrafen gemäss Art. 14 Abs. 2 SchKG und Art. 957 Abs. 2 ZGB, die über Rüge, Verweis und Busse hinausgehen, können nur durch das Obergericht angeordnet werden."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "651e78f5e8b83c89aaa1e7fb70b00efd6aa1e9ce663093e200e1891ba49590a4"
    },
    {
      "id": "kanton/ZH/242/art_23",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "23",
      "artikelLabel": "§ 23",
      "bloecke": [
        {
          "absatz": null,
          "text": "Aufgehoben"
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "fffd896179b5a05de5123ab834ecf45024e7a99fc81a9e6dc269c8d0b54294f4"
    },
    {
      "id": "kanton/ZH/242/art_24",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "24",
      "artikelLabel": "§ 24",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Notariate erheben für ihre Amtshandlungen Gebühren."
        },
        {
          "absatz": "2",
          "text": "Die Gebühren fallen in die Staatskasse."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "a9e7efdfc2357d69b3ecb8e5253e45f4566f60b66dad342570eeb0d700c3bdf7"
    },
    {
      "id": "kanton/ZH/242/art_25",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "25",
      "artikelLabel": "§ 25",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Gebühr für die öffentliche Beurkundung beträgt",
          "items": [
            {
              "marke": "a",
              "text": "bei Eigentumsänderungen 1‰ des Verkehrswertes,"
            },
            {
              "marke": "b",
              "text": "bei der Errichtung oder Erhöhung von Grundpfandrechten 1‰ der Pfandsumme."
            }
          ]
        },
        {
          "absatz": "2",
          "text": "Die Gebühr für den Grundbucheintrag beträgt",
          "items": [
            {
              "marke": "a",
              "text": "bei Eigentumsänderungen 1‰ des Verkehrswertes,"
            },
            {
              "marke": "b",
              "text": "bei der Errichtung oder Erhöhung von Grundpfandrechten 1‰ der Pfandsumme."
            }
          ]
        },
        {
          "absatz": "3",
          "text": "Der Kantonsrat setzt Mindestansätze fest."
        },
        {
          "absatz": "4",
          "text": "Für die Errichtung und Erhöhung von Grundpfandrechten wird, soweit gleichzeitig solche Rechte zulasten desselben Pfandes gelöscht werden, nur eine Kanzleigebühr erhoben. Im übersteigenden Betrag wird die Promillegebühr gemäss Abs. 1 und 2 erhoben."
        },
        {
          "absatz": "5",
          "text": "Für die Eintragung der Erbfolge wird eine Kanzleigebühr erhoben."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "bd140be27d7cc98d564373959129b1d6a05e6f148ed7be940af9ac444bbea4a6"
    },
    {
      "id": "kanton/ZH/242/art_26",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "26",
      "artikelLabel": "§ 26",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Gebühr für die öffentliche Beurkundung der Gründung einer Handelsgesellschaft oder der Erhöhung ihres Kapitals durch Beschluss der General- oder Gesellschafterversammlung beträgt 1‰ des Gründungs- oder Erhöhungsbetrages."
        },
        {
          "absatz": "2",
          "text": "Der Kantonsrat setzt Mindest- und Höchstansätze fest."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "f64cf5504c94a522fb051982cd7ab7e956d2857824505cbdfa8f40b06dbbed32"
    },
    {
      "id": "kanton/ZH/242/art_27",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "27",
      "artikelLabel": "§ 27",
      "bloecke": [
        {
          "absatz": null,
          "text": "Für die übrigen Amtshandlungen setzt der Kantonsrat die Gebühren durch Verordnung fest. Sie sollen dem Zeitaufwand und der Bedeutung des Geschäftes angepasst sein. Für Beurkundungen und Grundbucheinträge können sie, vorbehältlich höherer Mindestansätze, bis zu 1‰ des betroffenen Kapitals oder des Werts des betreffenden Rechts betragen."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "960423e3ab97dd05695a511e5979a9a5867f5bea7d3ef322f205a2649e3c9821"
    },
    {
      "id": "kanton/ZH/242/art_28",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "28",
      "artikelLabel": "§ 28",
      "bloecke": [
        {
          "absatz": null,
          "text": "Der Kantonsrat regelt durch Verordnung das Verfahren der Gebührenerhebung, die Gebührenfreiheit und den Gebührenerlass."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "26b61aa4a3f30e48471fecf51268f33dccbde96267ec6e18d054fc36b123544f"
    },
    {
      "id": "kanton/ZH/242/art_29",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "29",
      "artikelLabel": "§ 29",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Gebühren werden von der Person geschuldet, welche die Amtshandlung verlangt hat. Bei Eigentumsänderungen werden sie von beiden Parteien zu gleichen Teilen geschuldet."
        },
        {
          "absatz": "2",
          "text": "Geht das Begehren von mehreren Personen aus, haften sie solidarisch. Bei Eigentumsänderungen an Grundstücken und Errichtung oder Erhöhung von Grundpfandrechten gilt die Solidarhaftung auch für Grundstückerwerber und Pfandrechtsgläubiger."
        },
        {
          "absatz": "3",
          "text": "Unter den Parteien bleiben Rückgriffsansprüche und abweichende Vereinbarungen vorbehalten."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "c2fa9a13ba01cefe9e00091bb8719f7a55fc1ffa33c250c2539f12fa526293da"
    },
    {
      "id": "kanton/ZH/242/art_30",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "30",
      "artikelLabel": "§ 30",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Finanzdirektion lässt die Gebührenerhebung durch das Notariatsinspektorat überwachen."
        },
        {
          "absatz": "2",
          "text": "Bei unrichtiger Festsetzung der Gebühren durch das Notariat kann das Notariatsinspektorat die Rückerstattung oder den Nachbezug anordnen. Das Nachforderungsrecht erlischt zwei Jahre nach der unrichtigen Rechnungstellung."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "155c3912d16894fe7305f9b88f2faed68c78020d19425a04c8ad063ff64b5a0c"
    },
    {
      "id": "kanton/ZH/242/art_31",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "31",
      "artikelLabel": "§ 31",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Gegen Verfügungen, die sich auf die Notariats- und Grundbuchgebühren beziehen, kann gemäss Verwaltungsrechtspflegegesetz bei der Finanzdirektion Rekurs erhoben werden."
        },
        {
          "absatz": "2",
          "text": "Gegen Rekursentscheide der Finanzdirektion kann beim Verwaltungsgericht Beschwerde erhoben werden."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "c19c91d8d01e881550a546fd95782bcae5bab17ac94fba8a76e13aa103950e12"
    },
    {
      "id": "kanton/ZH/242/art_32",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "32",
      "artikelLabel": "§ 32",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Notariatsverwaltung obliegt dem Obergericht."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "4dc55e3550c7a541db344ca2f36b6ec80105ffaf9a8e18fc79b72def28195818"
    },
    {
      "id": "kanton/ZH/242/art_33",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "33",
      "artikelLabel": "§ 33",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Untere Aufsichtsbehörde ist das Bezirksgericht. Vorbehalten bleibt § 139 GOG."
        },
        {
          "absatz": "2",
          "text": "Gegen Verfügungen der Notariate, die sich nicht auf die Notariatsund Grundbuchgebühren beziehen, sowie wegen Verweigerung oder Verzögerung einer Amtshandlung oder wegen anderen Verletzungen von Amtspflichten kann beim Bezirksgericht Aufsichtsbeschwerde erhoben werden. §§ 82 und 83 GOG sind sinngemäss anwendbar."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "07c63e10a43324ea8d7645e0e26edfc46b5c7867e9081192207edd4db27a1ee5"
    },
    {
      "id": "kanton/ZH/242/art_34",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "34",
      "artikelLabel": "§ 34",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Obere Aufsichtsbehörde ist das Obergericht."
        },
        {
          "absatz": "2",
          "text": "Gegen Beschwerdeentscheide gemäss § 33 Abs. 2 kann beim Obergericht Beschwerde erhoben werden. § 84 GOG ist anwendbar."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "26a4b5498fb91dd3125e83c486d00a4b461e9306cb5bb45a7d9921b4b30e6d90",
      "sha": "e6bf1dd2bdda6a562d3b82dad551e300879d90fe284aedc8b16ddba5f8eba7c9"
    },
    {
      "id": "kanton/ZH/242/art_35",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Notariatsgesetz (NotG) (LS 242)",
      "artikel": "35",
      "artikelLabel": "§ 35",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Dem Obergericht ist das Notariatsinspektorat angegliedert."
        },
        {
          "absatz": "2",
          "text": "Das Notariatsinspektorat übt die unmittelbare Aufsicht über die Amtsführung der Notariate aus, insbesondere durch regelmässige Besuche."
        },
        {
          "absatz": "3",
          "text": "Das Obergericht kann dem Notariatsinspektorat weitere Aufgaben übertragen."
        },
        {
          "absatz": "4",
          "text": "Das Obergericht stellt die Notariatsinspektoren und ihre Adjunkte an. § 21 ist auch auf sie anwendbar."
        }
      ],
      "stand": "2017-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-242-1985_06_09-1989_01_01-095.html",
      "abgerufen": "2026-09-01",

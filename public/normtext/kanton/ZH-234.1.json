    {
      "id": "kanton/ZH/234.1/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Bundesgesetz über den Erwerb von Grundstücken durch Personen im Ausland (EG BewG) (LS 234.1)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": null,
          "text": "Der Erwerb eines Grundstückes wird einer Person im Ausland bewilligt, wenn das Grundstück einer natürlichen Person als Zweitwohnung dient an einem Ort, zu dem sie aussergewöhnlich enge, schutzwürdige Beziehungen unterhält, solange diese andauern."
        }
      ],
      "stand": "2011-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-234_1-1988_12_04-1989_01_01-071.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "d59ad364b9ce25e8c15dfa81049de369beab98558be04cf1f46244ef04a7b5e7",
      "sha": "09229fb6d86d6a4970a64c8862b5226eb44dff1ff16aea5197af7c735c5ac49f"
    },
    {
      "id": "kanton/ZH/234.1/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Bundesgesetz über den Erwerb von Grundstücken durch Personen im Ausland (EG BewG) (LS 234.1)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die weiteren Bewilligungsvoraussetzungen regelt das Bundesrecht."
        }
      ],
      "stand": "2011-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-234_1-1988_12_04-1989_01_01-071.html",

    {
      "id": "kanton/ZH/234.1/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Bundesgesetz über den Erwerb von Grundstücken durch Personen im Ausland (EG BewG) (LS 234.1)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": null,
          "text": "Es werden bezeichnet:",
          "items": [
            {
              "marke": "a",
              "text": "die Bezirksräte als Bewilligungsbehörden,"
            },
            {
              "marke": "b",
              "text": "die zuständige Direktion des Regierungsrates als beschwerdeberechtigte kantonale Behörde,"
            },
            {
              "marke": "c",
              "text": "das Baurekursgericht als erste und das Verwaltungsgericht als zweite Beschwerdeinstanz,"
            },
            {
              "marke": "d",
              "text": "die Zürcher Kantonalbank als Depositenstelle zur Hinterlegung von Anteilen an Immobiliengesellschaften."
            }
          ]
        }
      ],
      "stand": "2011-01-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-234_1-1988_12_04-1989_01_01-071.html",

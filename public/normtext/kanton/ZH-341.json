{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/341/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Nicht gewinnorientierte private Organisationen oder Einrichtungen von Gemeinden können als Beratungsstellen im Sinne des Bundesgesetzes vom 23. März 2007 über die Hilfe an Opfer von Straftraten (Opferhilfegesetz, OHG) anerkannt werden."
        },
        {
          "absatz": "2",
          "text": "Der Regierungsrat kann kantonale Beratungsstellen schaffen und durch Verordnung ihre Unterstellung und ihren Betrieb regeln."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "c2c389ea3ec505a35c3776efc7d4d76defddbedfb15e1252b3c7700ce4a76552"
    },
    {
      "id": "kanton/ZH/341/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Regierungsrat kann Beratungsstellen anerkennen, wenn",
          "items": [
            {
              "marke": "a",
              "text": "sie dafür Gewähr bieten, dass ihre Tätigkeit den Anforderungen des Opferhilfegesetzes genügt,"
            },
            {
              "marke": "b",
              "text": "ihr Angebot einem Bedarf entspricht."
            }
          ]
        },
        {
          "absatz": "2",
          "text": "Er kann weitere Anforderungen festlegen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "4167ac5002001ed14f99a554fbf3d0a48adddc4cb3870af60ecccd87694acf9d"
    },
    {
      "id": "kanton/ZH/341/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Kanton leistet den anerkannten Beratungsstellen für die Erfüllung ihrer Aufgaben gemäss Opferhilfegesetz Kostenanteile in voller Höhe der beitragsberechtigten Ausgaben."
        },
        {
          "absatz": "2",
          "text": "Die zuständige Direktion setzt die Kostenanteile unabhängig von ihrer Höhe im Einzelnen fest und schliesst dazu Leistungsvereinbarungen ab."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "478b9c2eb68c4ed3bbbbb2de28018269e8efb1c9ad5733ee0c1c6c259e92ce7f"
    },
    {
      "id": "kanton/ZH/341/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die anerkannten Beratungsstellen unterstehen der Aufsicht der zuständigen Direktion. Sie erteilen ihr die für eine sachgerechte Aufsicht erforderlichen Auskünfte."
        },
        {
          "absatz": "2",
          "text": "Sind die Voraussetzungen für eine Anerkennung nicht mehr gegeben, wird diese entzogen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "587499bca4df8d432ec25b7dfe940483d70e471d2f284f409a1c9789170d44d1"
    },
    {
      "id": "kanton/ZH/341/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die vom Opfer einer Straftat angesprochene Beratungsstelle ist zur Beratung und Hilfeleistung verpflichtet und bleibt dafür verantwortlich, wenn sie mit anderen Stellen zusammenarbeitet."
        },
        {
          "absatz": "2",
          "text": "Sie kann das Opfer einer Straftat, das ihre Hilfe in Anspruch nehmen will, an eine andere anerkannte Beratungsstelle verweisen, wenn dadurch bessere Hilfe geleistet werden kann. Sie bleibt jedoch für die Beratung und Hilfeleistung verantwortlich, bis die neue Stelle den Fall übernimmt."
        },
        {
          "absatz": "3",
          "text": "Die Beratungsstellen führen ein Register der Personen, die materielle Hilfe in Anspruch nehmen. Sie geben anderen anerkannten Beratungsstellen auf Anfrage darüber Auskunft, ob eine Person materielle Hilfe erhalten hat."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "068d54ef181b4eff589046b5a5f9383b4c2bb3c5e1ddc432a9db43c4aaefbad8"
    },
    {
      "id": "kanton/ZH/341/art_6",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "6",
      "artikelLabel": "§ 6",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die zuständige Direktion kann zur Erfüllung weiterer von den anerkannten Beratungsstellen nicht gewährleisteter Hilfeleistungen Dritte beiziehen."
        },
        {
          "absatz": "2",
          "text": "Sie kann zu diesem Zweck Leistungsverträge abschliessen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "54d872daaf3f328933e5439ba987fc19a3b86ca09558bbbf7f107ad65968672d"
    },
    {
      "id": "kanton/ZH/341/art_7",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "bloecke": [
        {
          "absatz": null,
          "text": "Der Kanton sorgt für ein ausreichendes Angebot an Schutzunterkünften für gewaltbetroffene Menschen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "61c88cf905d61cd76fb996ae5dc9f3d01d61f0952cf8405ccec479541a6ef48b"
    },
    {
      "id": "kanton/ZH/341/art_7_a",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "7_a",
      "artikelLabel": "§ 7a",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Regierungsrat kann Organisationen, die Schutzunterkünfte betreiben, anerkennen, wenn",
          "items": [
            {
              "marke": "a",
              "text": "ihre Tätigkeit wirtschaftlich und zweckmässig sowie die Qualität der Beratung, Betreuung und Unterbringung gewährleistet ist,"
            },
            {
              "marke": "b",
              "text": "ihr Angebot einem Bedarf entspricht."
            }
          ]
        },
        {
          "absatz": "2",
          "text": "Er kann weitere Anforderungen festlegen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "a4be4f80950a8b169583f17dd83ad9ec8a6c1b241e6071c3a7948650933a9833"
    },
    {
      "id": "kanton/ZH/341/art_7_b",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "7_b",
      "artikelLabel": "§ 7b",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Kanton kann den anerkannten Organisationen Subventionen zur Senkung des Bereitstellungsrisikos bis zur vollen Höhe der beitragsberechtigten Kosten ausrichten. Bei der Festsetzung der Höhe der Subventionen wird die Leistungsabgeltung nach Art. 13 und 14 OHG berücksichtigt."
        },
        {
          "absatz": "2",
          "text": "Die zuständige Direktion legt die Subventionen unabhängig von ihrer Höhe im Einzelnen fest und schliesst dazu Leistungsvereinbarungen ab."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "029045dc7ee13584942c3d810d7d5c6ee962284e05cde11cd660f68ac3812a5e"
    },
    {
      "id": "kanton/ZH/341/art_7_c",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "7_c",
      "artikelLabel": "§ 7c",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Schutzunterkünfte der anerkannten Organisationen unterstehen der Aufsicht des Bezirksrates und der übergeordneten Aufsicht der zuständigen Direktion."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "0311a933f6d18a349841814093bb154d6c0921cee64dcd54c00850d6a3264d61"
    },
    {
      "id": "kanton/ZH/341/art_8",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "8",
      "artikelLabel": "§ 8",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Regierungsrat errichtet eine kantonale Opferhilfestelle."
        },
        {
          "absatz": "2",
          "text": "Die Opferhilfestelle setzt auf Gesuch des Opfers einer Straftat oder seiner Angehörigen die Höhe der finanziellen Leistungen im Sinne des Opferhilfegesetzes fest und richtet diese aus."
        },
        {
          "absatz": "3",
          "text": "Der Regierungsrat erlässt eine Verordnung über Unterstellung und Verfahren der Opferhilfestelle."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "0a2d8ea53daf0c80a0bc371ef64961f857fbbdc983850e5193d8573338e91e19"
    },
    {
      "id": "kanton/ZH/341/art_9",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "9",
      "artikelLabel": "§ 9",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Opferhilfestelle entscheidet aufgrund des Gesuchs des Opfers, der Akten des Strafverfahrens und ihrer eigenen Abklärungen sowie der Berichte von Experten. Das Opfer ist verpflichtet, alle zur Beurteilung seines Gesuchs erforderlichen Informationen und Unterlagen zur Verfügung zu stellen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "e3c07e90b825b974a24d854f8604110888e494d1837da5bc2cb19c2a841c1be5"
    },
    {
      "id": "kanton/ZH/341/art_9_a",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "9_a",
      "artikelLabel": "§ 9a",
      "bloecke": [
        {
          "absatz": null,
          "text": "Staatsanwaltschaften und Jugendanwaltschaften gewähren der Opferhilfestelle direkten elektronischen Zugriff auf Daten, einschliesslich Personendaten und besonderer Personendaten, von hängigen und abgeschlossenen Verfahren."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "d15da12993eca37174b4a3460feeb1695bb76c2c3eb04736aac5194e6a02d130"
    },
    {
      "id": "kanton/ZH/341/art_9_b",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "9_b",
      "artikelLabel": "§ 9b",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Zugriff ist zulässig, wenn die Daten wesentliche Aufschlüsse für ein hängiges Opferhilfeverfahren geben können."
        },
        {
          "absatz": "2",
          "text": "Der Regierungsrat stellt sicher, dass",
          "items": [
            {
              "marke": "a",
              "text": "der Zugriff der Opferhilfestelle auf die für ihre Aufgabenerfüllung notwendigen Daten beschränkt ist und"
            },
            {
              "marke": "b",
              "text": "der Untersuchungszweck durch den Zugriff nicht gefährdet wird."
            }
          ]
        },
        {
          "absatz": "3",
          "text": "Er regelt die Einzelheiten des Zugriffs auf die Daten, erlässt Datensicherheitsvorschriften und regelt die Zugriffsrechte."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "db3875f0f3ce1d952d2576d068913c3709c33d25db491319460ac9c247318f51"
    },
    {
      "id": "kanton/ZH/341/art_10",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "10",
      "artikelLabel": "§ 10",
      "bloecke": [
        {
          "absatz": null,
          "text": "Benötigt das Opfer sofortige finanzielle Hilfe oder können die Folgen der Straftat nicht kurzfristig mit hinreichender Sicherheit festgestellt werden, entscheidet die Opferhilfestelle innert vier Wochen über die Ausrichtung eines Vorschusses. Übersteigt der Vorschuss die Entschädigung, ist der Mehrbetrag zurückzuerstatten. Auf die Rückforderung wird verzichtet, wenn diese das Opfer in eine schwierige wirtschaftliche Lage bringen würde."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "6496b6e064008e16c9389ec2c8810338c519d59d4dda2acec83e072ae5551313"
    },
    {
      "id": "kanton/ZH/341/art_11",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "11",
      "artikelLabel": "§ 11",
      "bloecke": [
        {
          "absatz": null,
          "text": "Aufgehoben"
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "fffd896179b5a05de5123ab834ecf45024e7a99fc81a9e6dc269c8d0b54294f4"
    },
    {
      "id": "kanton/ZH/341/art_12",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "12",
      "artikelLabel": "§ 12",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Opferhilfestelle kann auf die Begründung verzichten und den Entscheid nur im Dispositiv mitteilen. Statt einer Rechtsmittelbelehrung wird der gesuchstellenden Person angezeigt, dass sie innert zehn Tagen seit dieser Mitteilung schriftlich eine Begründung verlangen kann, ansonst der Entscheid in Rechtskraft erwachse."
        },
        {
          "absatz": "2",
          "text": "Die Rechtsmittelfrist beginnt mit der Zustellung des begründeten Entscheids zu laufen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "48b9ba64e2cb3c88fae38f5fc0b0060a5d5f6c681be5fe589eb07aa4fdd86e30",
      "sha": "8a71259d5ef7b2df1c32dbb79a6b9f5f4b52a2007b5a915063ca46ba3c33f441"
    },
    {
      "id": "kanton/ZH/341/art_13",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "13",
      "artikelLabel": "§ 13",
      "bloecke": [
        {
          "absatz": null,
          "text": "Aufgehoben"
        }

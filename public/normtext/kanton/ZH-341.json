    {
      "id": "kanton/ZH/341/art_15",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "15",
      "artikelLabel": "§ 15",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Wird eine Entschädigung oder Genugtuung geleistet, macht die kantonale Opferhilfestelle die Ansprüche des Kantons gegenüber der Täterin oder dem Täter geltend."
        },
        {
          "absatz": "2",
          "text": "Werden dadurch schützenswerte Interessen des Opfers verletzt oder wird die Wiedereingliederung des Täters gefährdet, kann die kantonale Opferhilfestelle auf die Geltendmachung verzichten."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",
      "abgerufen": "2026-09-01",

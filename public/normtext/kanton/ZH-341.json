      "sha": "42ccac0a6f2e3c2747c46ba830ed9d94376ddc2203e1111658c06b1e10f39744"
    },
    {
      "id": "kanton/ZH/341/art_16",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Einführungsgesetz zum Opferhilfegesetz (EG OHG) (LS 341)",
      "artikel": "16",
      "artikelLabel": "§ 16",
      "bloecke": [
        {
          "absatz": null,
          "text": "Das Opfer kann gegen den Entscheid der kantonalen Opferhilfestelle über Entschädigung und Genugtuung sowie über die Soforthilfe und die Übernahme weiterer Kosten innert 30 Tagen ab Zustellung des begründeten Entscheids Beschwerde an das Sozialversicherungsgericht erheben."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341-1995_06_25-1996_01_01-124.html",

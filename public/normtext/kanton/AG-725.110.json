    },
    {
      "id": "kanton/AG/725.110/art_20",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "20",
      "artikelLabel": "§ 20",
      "titel": "Beschwerden gegen Gebührenrechnungen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Gegen Gebührenrechnungen kann innert 30 Tagen seit Zustellung beim Regierungsrat Beschwerde geführt werden. Hierzu sind sowohl die Parteien als auch die Urkundsperson, die das Geschäft angemeldet hat, legitimiert."
        },
        {
          "absatz": "2",
          "text": "Der Entscheid des Regierungsrats kann innert 30 Tagen seit Zustellung an das Verwaltungsgericht weitergezogen werden."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "d13bc86b1199a092b62ce9b6fbd6abc89cb4ee5b21786af65f154ba6e32f73fa"
    },
    {
      "id": "kanton/AG/725.110/art_21",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "21",
      "artikelLabel": "§ 21",
      "titel": "Vollstreckbarkeit der Gebührenrechnungen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Rechtskräftige Gebührenrechnungen bilden Rechtsöffnungstitel im Sinne von Art. 80 Abs. 2 des Bundesgesetzes über Schuldbetreibung und Konkurs."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",

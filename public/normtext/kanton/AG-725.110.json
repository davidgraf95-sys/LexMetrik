{
  "erzeugt": "2026-09-06",
  "eintraege": [
    {
      "id": "kanton/AG/725.110/art_1",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "titel": "Grundsatz",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Kanton erhebt auf den grundbuchlichen Verrichtungen eine Gebühr nach Massgabe dieses Dekretes."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "057b2da95e53c536e6017a64d64d070f6b664e143ce7acf68da8bc46e7ebad6a"
    },
    {
      "id": "kanton/AG/725.110/art_2",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "titel": "Ersatz der Auslagen, Befreiung von Gebühren, etc.",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Bezüglich Ersatz der Auslagen, Befreiung von Gebühren, Gebührenerlass, Zahlungsart und Haftung sowie Eintrag in mehreren Bezirken gelten sinngemäss die Bestimmungen des Gesetzes über die Grundbuchabgaben vom 7. Mai 1980 (§§ 1, 2, 3, 5 und 6)."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "589fdcd25ef3163488cd4ce48a433375c3a983a0dcc31786f4c9befd38655cb0"
    },
    {
      "id": "kanton/AG/725.110/art_3",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "titel": "Gebührenfestsetzung",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Ist für eine Verrichtung weder eine Gebühr noch im Gesetz über die Grundbuchabgaben eine Abgabe vorgesehen, so ist nach dem Zeitaufwand eine Gebühr festzusetzen, die sich nach dem Stundenlohnansatz des Sachbearbeiters bemisst."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "a718f504c78376572d94c935bd5a2fe63d14c4d1edf93ac2c69cc2e0f74bbfb6"
    },
    {
      "id": "kanton/AG/725.110/art_4",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "titel": "Vereinigung von Parzellen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Vereinigung von Parzellen werden pro Blattabschluss Fr. 40.– erhoben. Art. 954 Abs. 2 des Schweizerischen Zivilgesetzbuches bleibt vorbehalten."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "c3d822b22022cb58f46dce5df7f0769abf3dbd5dbf78ab7c46c7aa5920a22ff1"
    },
    {
      "id": "kanton/AG/725.110/art_4_a",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "4_a",
      "artikelLabel": "§ 4a",
      "titel": "Handänderungen bei Umstrukturierungen von Unternehmen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für Handänderungen, die auf Umstrukturierungen von Unternehmen zurückzuführen sind, beträgt die Gebühr Fr. 250.– für ein einzelnes Grundstück. Für jedes weitere Grundstück beträgt die Gebühr Fr. 150.–."
        },
        {
          "absatz": "2",
          "text": "Als Handänderungen im Zusammenhang mit Umstrukturierungen gelten Handänderungen",
          "items": [
            {
              "marke": "a",
              "text": "bei Umstrukturierungen gemäss den §§ 28 Abs. 1 sowie 71 Abs. 1 und 3 des Steuergesetzes (StG) vom 15. Dezember 1998,"
            },
            {
              "marke": "b",
              "text": "infolge von Umstrukturierungen gemäss Art. 88 und 98 des Bundesgesetzes über Fusion, Spaltung, Umwandlung und Vermögensübertragung (Fusionsgesetz, FusG) vom 3. Oktober 2003, beschränkt auf Personalvorsorgestiftungen des gleichen Unternehmens oder der gleichen Unternehmensgruppe,"
            },
            {
              "marke": "c",
              "text": "an Grundstücken im Eigentum von juristischen Personen, die wertmässig von der gleichen Person beherrscht werden, wenn diese Beherrschung seit mindestens einem Jahr besteht."
            }
          ]
        },
        {
          "absatz": "3",
          "text": "Absatz 1 und 2 gelten sinngemäss für Anstalten und Körperschaften des öffentlichen Rechts, mit Ausnahme der in Absatz 2 lit. c enthaltenen zeitlichen Beschränkung."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "1e1b19bc7b6d16b6e4f7e6e5f30419327a82e5fef5baf489edad071f46116f2a"
    },
    {
      "id": "kanton/AG/725.110/art_5",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "titel": "Änderung der Firmenbezeichnung",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die blosse Änderung der Firmenbezeichnung, wie die Änderung des Firmennamens oder die Sitzverlegung, für Namensänderungen von natürlichen Personen, Vereinen, kulturellen Genossenschaften und Stiftungen, beträgt die Gebühr Fr. 40.– pro Grundstück."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "b98469551bd0a6f715206a6f986a937cd54afd0881bf0e94d45e833813c82034"
    },
    {
      "id": "kanton/AG/725.110/art_6",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "6",
      "artikelLabel": "§ 6",
      "titel": "Gläubigerwechsel",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Angabe eines Gläubigerwechsels, eines Faustpfandgläubigers, eines Verwaltungs- oder Nutzniessungsrechtes, für Nachgangserklärungen von Grundpfandgläubigern zu Gunsten von Pfandrechten, Dienstbarkeiten und Vormerkungen anderer Berechtigter werden Fr. 40.– erhoben."
        },
        {
          "absatz": "2",
          "text": "Bei Angabe mehrerer Gläubiger des gleichen Pfandrechtes werden für jeden weiteren Gläubiger Fr. 40.– erhoben."
        },
        {
          "absatz": "3",
          "text": "Für Adressänderungen von Grundpfandgläubigern, Faustpfandgläubigern usw. oder für die Übertragung von Titeln von der Hauptbank auf eine Filiale der gleichen Bank werden Fr. 40.– berechnet."
        },
        {
          "absatz": "4",
          "text": "Löschungen im Gläubigerregister sind gebührenfrei."
        },
        {
          "absatz": "5",
          "text": "…"
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "7b766f48fb772466147e05566b86edae9a1792c156b1a61823ab935eb8828bca"
    },
    {
      "id": "kanton/AG/725.110/art_6_a",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "6_a",
      "artikelLabel": "§ 6a",
      "titel": "Umwandlung bestehender Grundpfandrechte",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Umwandlung bestehender Grundpfandrechte beträgt die Gebühr Fr. 90.– für ein einzelnes Grundstück. Für jedes weitere Grundstück beträgt die Gebühr Fr. 30.–."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "d96a20bdf664c1223107cdc235ef270650318d7125d1ef6cec5c873c3cdbfc1f"
    },
    {
      "id": "kanton/AG/725.110/art_7",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "titel": "Nachgangserklärungen von Dienstbarkeits- und Vormerkungsberechtigten",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für Nachgangserklärungen von Dienstbarkeits- und Vormerkungsberechtigten ist eine Gebühr von Fr. 40.– zu entrichten."
        },
        {
          "absatz": "2",
          "text": "Für die nachträgliche Eintragung einer Nachgangserklärung wird eine Gebühr von Fr. 40.– berechnet."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "633bf06a4d81f848820a264b81ca122a3e162d1ce3ce8f4760f69be5380c02a2"
    },
    {
      "id": "kanton/AG/725.110/art_8",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "8",
      "artikelLabel": "§ 8",
      "titel": "Löschung von Pfandrechten",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Löschung von vertraglichen und gesetzlichen Grundpfandrechten werden Fr. 40.– erhoben."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "cfa740054cf3c39d6f1cc29e800e3ed3ce194702583b3fe0c8e4a0884d63e2a1"
    },
    {
      "id": "kanton/AG/725.110/art_9",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "9",
      "artikelLabel": "§ 9",
      "titel": "Pfandentlassungen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Gebühr für Pfandentlassungen beträgt Fr. 40.–."
        },
        {
          "absatz": "2",
          "text": "Bei Pfandentlassung von mehreren Grundstücken werden pro Grundstück maximal Fr. 40.– erhoben."
        },
        {
          "absatz": "3",
          "text": "In beiden Fällen darf die Gebühr die Höhe der Löschungsgebühr für das Pfandrecht nicht übersteigen."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "d35ed0e2e038edd6e7b193f2a0b0148e4b3a14b855d0fba104a29debda6d5161"
    },
    {
      "id": "kanton/AG/725.110/art_10",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "10",
      "artikelLabel": "§ 10",
      "titel": "Zins- und Zahlungsbestimmungen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Änderung der Zins- und Zahlungsbestimmungen wird eine Gebühr von Fr. 40.– berechnet."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "5be7217256698d1cec078a46e8696212ebfff2b5a2a5513b0ea5aa16be6422e8"
    },
    {
      "id": "kanton/AG/725.110/art_11",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "11",
      "artikelLabel": "§ 11",
      "titel": "Ausfertigung von Schuldbriefen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Neuausfertigung von Schuldbriefen werden Fr. 60.– berechnet."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "181a61903ea1594e04ad5007abf42f6e4594c203e35ed2da41d6bed88c72a430"
    },
    {
      "id": "kanton/AG/725.110/art_12",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "12",
      "artikelLabel": "§ 12",
      "titel": "Titelnachtragungen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Nachtragung von Grundpfandtiteln auf Verlangen des Gläubigers wird pro Titel eine Gebühr von Fr. 40.– berechnet."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "5c31cc38798b6a4ea467eb802b9d8303e83b0bcf4e429449f9169f6519b5e9d3"
    },
    {
      "id": "kanton/AG/725.110/art_13",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "13",
      "artikelLabel": "§ 13",
      "titel": "Andere Anmerkungen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Einschreibung von Anmerkungen, die nicht Zugehör betreffen, beträgt die Gebühr Fr. 40.–."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "e215519cf5f037f632cb79fc6e61caa0a1ae9a7c52aa22e318c08c03db0320d7"
    },
    {
      "id": "kanton/AG/725.110/art_14",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "14",
      "artikelLabel": "§ 14",
      "titel": "Gewinnanteile der Miterben",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Bei Vormerkung des Gewinnanteils der Miterben wird eine Gebühr von Fr. 40.– bezogen."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "05392e6c8de6a026c85f0c759f75816b36a04d7418c4831294d414b1733557cf"
    },
    {
      "id": "kanton/AG/725.110/art_15",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "15",
      "artikelLabel": "§ 15",
      "titel": "Pfändungen und Arreste",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Vormerkung von Pfändungen und Arresten werden Fr. 40.– berechnet."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "e91392f53f565f4a7cdb8c197dbc9f02d8609826c11d1a7e65bd714a0b14761c"
    },
    {
      "id": "kanton/AG/725.110/art_16",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "16",
      "artikelLabel": "§ 16",
      "titel": "Andere Vormerkungen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Gebühr für andere Vormerkungen, Verfügungsbeschränkungen und vorläufige Eintragungen beträgt Fr. 40.–. Diese Gebühr ist auch bei Verlängerung der Geltung der Vormerkung zu entrichten."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "e517500cca6f39c4460e6d71cc54f927aa61040862306e99c4346b20edb6f867"
    },
    {
      "id": "kanton/AG/725.110/art_17",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "17",
      "artikelLabel": "§ 17",
      "titel": "Übertragung von Dienstbarkeiten",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Übertragung von Dienstbarkeiten infolge von Parzellierung und Vereinigung wird pro Dienstbarkeitsrecht eine Gebühr von Fr. 40.– berechnet."
        },
        {
          "absatz": "2",
          "text": "Die gleiche Gebühr ist zu erheben bei der Übertragung von Dienstbarkeiten infolge Tausch."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "750cb0a63d04b19747829f7612b9f239cdd1e62298bbfc335ccaeb4d65e8e127"
    },
    {
      "id": "kanton/AG/725.110/art_18",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "18",
      "artikelLabel": "§ 18",
      "titel": "Löschungen",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Für die Löschung von Anmerkungen, Vormerkungen, Dienstbarkeiten und Grundlasten sind keine Gebühren zu entrichten."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",
      "abgerufen": "2026-09-06",
      "fassungsToken": "fc6c28d8972f14f2186db8f062285241",
      "sha": "d77c9710ae9612f07ead737b43d167f4be974dabab4741fd50f0dc84c03148b1"
    },
    {
      "id": "kanton/AG/725.110/art_19",
      "ebene": "kanton",
      "quelle": "AG",
      "erlass": "Dekret über die Grundbuchgebühren (SAR 725.110)",
      "artikel": "19",
      "artikelLabel": "§ 19",
      "titel": "Kanzleigebühren",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Regierungsrat setzt die von den Grundbuchämtern zu erhebenden Kanzleigebühren fest."
        }
      ],
      "stand": "2018-01-01",
      "quelleUrl": "https://gesetzessammlungen.ag.ch/app/de/texts_of_law/725.110",

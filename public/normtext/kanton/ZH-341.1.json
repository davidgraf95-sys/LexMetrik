{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/341.1/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Direktion der Justiz und des Innern führt die Kantonale Opferhilfestelle."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "6005ce91568ca5899ab69dfe9b845b75b9d6adb5e27c0f98bb12b9573c6b873f"
    },
    {
      "id": "kanton/ZH/341.1/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Kantonale Opferhilfestelle hat folgende Aufgaben:",
          "items": [
            {
              "marke": "a",
              "text": "Sie beurteilt Gesuche um finanzielle Leistungen, sofern nicht die Beratungsstellen zuständig sind."
            },
            {
              "marke": "b",
              "text": "Sie vertritt den Kanton in Beschwerdeverfahren vor dem Sozialversicherungsgericht und dem Bundesgericht und bei der Geltendmachung von Regressansprüchen gegen Dritte, namentlich gegen die Täterin oder den Täter sowie gegen die Versicherer."
            },
            {
              "marke": "c",
              "text": "Sie richtet den in den Leistungsvereinbarungen festgelegten Kostenanteil und allfällige Teilzahlungen aus und sorgt für eine einheitliche und koordinierte Tätigkeit der Beratungsstellen."
            },
            {
              "marke": "d",
              "text": "Sie sorgt für die Information über die Opferhilfe und ihre Organisation im Kanton,"
            },
            {
              "marke": "e",
              "text": "Sie sorgt für die Weiterentwicklung des Angebots."
            }
          ]
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "27a5e19003973603e391f9933a1c9c3caa79f2fa7df98f5a1e34109c88676d62"
    },
    {
      "id": "kanton/ZH/341.1/art_2_a",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "2_a",
      "artikelLabel": "§ 2a",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Direktion der Justiz und des Innern ist für die Beratungsstellen zuständig."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "c9954ba738e571f708a2456a687a0efac5b1244e47ed2fd300ee41ddc1c9cb2a"
    },
    {
      "id": "kanton/ZH/341.1/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Anerkennung als Beratungsstelle setzt voraus:",
          "items": [
            {
              "marke": "a",
              "text": "ein Angebot, das einem ausgewiesenen Bedarf entspricht,"
            },
            {
              "marke": "b",
              "text": "ein Angebot, eine Organisation, Öffnungszeiten und einen Standort, die Gewähr für rasche und einfache geeignete Hilfeleistung an Opfer bieten,"
            },
            {
              "marke": "c",
              "text": "Mitarbeiterinnen und Mitarbeiter, die über eine fachlich angemessene Ausbildung und entsprechende Berufserfahrungen verfügen,"
            },
            {
              "marke": "d",
              "text": "ein Instrumentarium zur Qualitätssicherung und Qualitätsentwicklung,"
            },
            {
              "marke": "e",
              "text": "eine wirtschaftliche und zweckmässige Organisation und eine Grösse, mit der die Aufgaben in fachlicher und betriebswirtschaftlicher Hinsicht bestmöglich erfüllt werden können,"
            },
            {
              "marke": "f",
              "text": "fehlende Gewinnorientierung."
            }
          ]
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "0a5b50ae91e75f2018c1088ee8b896eb4d90a691dca5403ce457af90f63d59e1"
    },
    {
      "id": "kanton/ZH/341.1/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Das Gesuch um Anerkennung wird der Kantonalen Opferhilfestelle schriftlich eingereicht."
        },
        {
          "absatz": "2",
          "text": "Gesuche um Erneuerung der Anerkennung sind im Jahr vor Ablauf der Anerkennungsfrist bis 30. September einzureichen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "a174e888bec3f54a812d75ec1f534a2baf5a9a2dd057b830df389966a4f84f50"
    },
    {
      "id": "kanton/ZH/341.1/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Regierungsrat anerkennt die Beratungsstellen für längstens vier Jahre. Die Anerkennung kann erneuert werden."
        },
        {
          "absatz": "2",
          "text": "Sie kann mit Auflagen und Bedingungen verbunden werden."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "bd3bbe859947ad648438c01fa1c620cb7e67b146f51f3ee32bd4fee028c5d3af"
    },
    {
      "id": "kanton/ZH/341.1/art_6",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "6",
      "artikelLabel": "§ 6",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Beratungsstelle teilt der Kantonalen Opferhilfestelle spätestens sechs Monate vor Ablauf der Leistungsvereinbarung mit, wenn sie auf die Anerkennung verzichten will."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "1c7645f373254b43be6342f097770b7a649ded222c1601f2802bbf8b998da702"
    },
    {
      "id": "kanton/ZH/341.1/art_7",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Regierungsrat widerruft die Anerkennung, wenn",
          "items": [
            {
              "marke": "a",
              "text": "die Voraussetzungen gemäss § 3 nicht mehr erfüllt sind und der Mangel nicht innert angemessener Frist behoben wird oder"
            },
            {
              "marke": "b",
              "text": "die Beratungsstelle eine schwere Pflichtverletzung begeht."
            }
          ]
        },
        {
          "absatz": "2",
          "text": "Eine schwere Pflichtverletzung liegt insbesondere vor, wenn die Kostenanteile zweckwidrig verwendet werden oder wenn die Beratungsstelle die Interessen des Kantons oder der Opfer gefährdet."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "b05c32b07d685103b89dc27942f9940baf568b28fffd9e1d449a160e329a7748"
    },
    {
      "id": "kanton/ZH/341.1/art_8",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "8",
      "artikelLabel": "§ 8",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Beratungsstellen erfüllen die Aufgaben gemäss Art. 12 und 13 des Bundesgesetzes vom 23. März 2007 über die Hilfe an Opfer von Straftaten."
        },
        {
          "absatz": "2",
          "text": "Sie unterstützen das Opfer bei der Geltendmachung der finanziellen Ansprüche bei der Kantonalen Opferhilfestelle."
        },
        {
          "absatz": "3",
          "text": "Sie sind Beratungsstellen für gefährdete Personen gemäss § 16 GSG."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "67940a4e34b0e0d962e13bd37a25e08128ae2f9d3f28717edf086fac210247ef"
    },
    {
      "id": "kanton/ZH/341.1/art_9",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "9",
      "artikelLabel": "§ 9",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Beratungsstellen gewähren dem Opfer finanzielle Soforthilfe bis höchstens Fr. 1000."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "abff5d7170cece75c00eae2dc9d6f966537ce61094de9d9527930e50d8f18bc3"
    },
    {
      "id": "kanton/ZH/341.1/art_10",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "10",
      "artikelLabel": "§ 10",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Kantonale Opferhilfestelle ersetzt der Beratungsstelle die Ausgaben für die finanzielle Hilfe an Opfer und die Übersetzungskosten."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "d3ecd1325ac5e6aa8139caa337c219d3fef4d2830d805d903644c7bb3e31c9d6"
    },
    {
      "id": "kanton/ZH/341.1/art_11",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "11",
      "artikelLabel": "§ 11",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Direktion der Justiz und des Innern und die Beratungsstelle schliessen Leistungsvereinbarungen für längstens vier Jahre ab."
        },
        {
          "absatz": "2",
          "text": "Kommt keine Vereinbarung zustande, legt die Direktion diesLeistungen der Beratungsstelle und den Kostenanteil fest."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "2418df25e1a3a87ebb7883804c573201bac8bd0a258ce7349b84174a7792be09"
    },
    {
      "id": "kanton/ZH/341.1/art_12",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "12",
      "artikelLabel": "§ 12",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Leistungsvereinbarung legt Art und Umfang der Leistungen der Beratungsstelle und die Qualitätsvorgaben fest."
        },
        {
          "absatz": "2",
          "text": "Die Leistungen können auf die Hilfe für bestimmte Opfergruppen, wie Kinder, Jugendliche oder Opfer von Sexual- oder Strassenverkehrsdelikten, beschränkt werden."
        },
        {
          "absatz": "3",
          "text": "In der Leistungsvereinbarung werden insbesondere festgelegt:",
          "items": [
            {
              "marke": "a",
              "text": "die Leistungen und deren Mengen,"
            },
            {
              "marke": "b",
              "text": "die Qualität der Leistungen,"
            },
            {
              "marke": "c",
              "text": "der Kostenanteil und allfällige Teilzahlungen,"
            },
            {
              "marke": "d",
              "text": "die Regelung der Rückerstattungen,"
            },
            {
              "marke": "e",
              "text": "die Berichterstattungspflicht."
            }
          ]
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "fb2633ced2ea6e67a68f0848148aea5236372dc5ec2db5d284cf53a3596f99dc"
    },
    {
      "id": "kanton/ZH/341.1/art_13",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "13",
      "artikelLabel": "§ 13",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Kostenanteil wird leistungsbezogen und unter Anrechnung von Eigenleistungen festgesetzt."
        },
        {
          "absatz": "2",
          "text": "Er berechnet sich nach Art und Umfang der Leistungen und ihrem Preis."
        },
        {
          "absatz": "3",
          "text": "Der Preis der Leistungen wird unter Berücksichtigung von Normwerten für alle Beratungsstellen einheitlich festgelegt. Er gilt in der Regel für zwei Jahre."
        },
        {
          "absatz": "4",
          "text": "Bei der Anrechnung von Eigenleistungen wird berücksichtigt, dass die Beratungsstelle in angemessenem Umfang Reserven bilden kann."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "b2b8701b72b2675703dc9f8917ee66647ec9d897d76680469a66bd356bd43669"
    },
    {
      "id": "kanton/ZH/341.1/art_14",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "14",
      "artikelLabel": "§ 14",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Beratungsstelle führt eine ordnungsgemässe Buchhaltung. Sie befolgt bei der Rechnungslegung die Grundsätze der Transparenz und der Vergleichbarkeit."
        },
        {
          "absatz": "2",
          "text": "Sie reicht der Kantonalen Opferhilfestelle bis 30. April den Jahresabschluss des Vorjahres ein."
        },
        {
          "absatz": "3",
          "text": "Sie erstattet der Kantonalen Opferhilfestelle jährlich Bericht über ihre Tätigkeit und halbjährlich Bericht über ihre Leistungen."
        },
        {
          "absatz": "4",
          "text": "Die Kantonale Opferhilfestelle ist befugt, die Beratungsstellen jederzeit zu kontrollieren und die Voraussetzungen der Abgeltung der Leistungen und die Einhaltung der Qualitätsvorgaben zu überprüfen. Die Beratungsstelle gewährt ihr dazu Einblick in die Bücher und Belege und erteilt die für die Prüfung erforderlichen Auskünfte."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "c478cf00fba98ad0c9e3d6d53c38ba94253486d87793a9d3268aa070d4a78296"
    },
    {
      "id": "kanton/ZH/341.1/art_15",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "15",
      "artikelLabel": "§ 15",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Beratungsstelle erstattet Teilzahlungen zurück, wenn die Voraussetzungen für deren Ausrichtung nicht vorhanden waren oder sie für sachfremde Zwecke verwendet worden sind."
        },
        {
          "absatz": "2",
          "text": "Erbringt sie die vereinbarten Leistungen nicht oder nur teilweise, muss sie Teilzahlungen ganz oder teilweise zurückerstatten."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "826dd011a9666d16fcbfd88cb64e361adcfcad22c3eec215b8aa6c2a383d708e"
    },
    {
      "id": "kanton/ZH/341.1/art_16",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "16",
      "artikelLabel": "§ 16",
      "bloecke": [
        {
          "absatz": null,
          "text": "Kommt die Beratungsstelle ihren Aufgaben und Pflichten nicht nach, kann die Kantonale Opferhilfestelle den Kostenanteil kürzen oder verweigern."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "eec692ad0652caba1698ee5e01d66230d24337500344005f7f7677e5a97523fe"
    },
    {
      "id": "kanton/ZH/341.1/art_17",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "17",
      "artikelLabel": "§ 17",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Beratungsstellen unterstehen der Aufsicht der Kantonalen Opferhilfestelle."
        },
        {
          "absatz": "2",
          "text": "Die Kantonale Opferhilfestelle sorgt dafür, dass die Beratungsstellen ihre Leistungen qualitativ einheitlich und den Vorgaben entsprechend erbringen."
        },
        {
          "absatz": "3",
          "text": "Sie kann Richtlinien und Weisungen erlassen, insbesondere zur Gewährleistung eines gesetzmässigen und einheitlichen Vollzugs, zur Qualitätssicherung und zur Rechnungslegung."
        },
        {
          "absatz": "4",
          "text": "Im Übrigen sind die Beratungsstellen in ihrer Tätigkeit fachlich selbstständig."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "c10347a7c337f20e533984e94c795f8df9c63bd984840ebacd18382df2fa9503"
    },
    {
      "id": "kanton/ZH/341.1/art_18",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "18",
      "artikelLabel": "§ 18",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Sicherheitsdirektion ist für die Schutzunterkünfte zuständig."
        },
        {
          "absatz": "2",
          "text": "Das Kantonale Sozialamt vollzieht die diesbezüglichen Bestimmungen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "1e10fa4fcd1dd42a4fe80a7f53c56962846bae50c98a4a6642e7bdf058da8276"
    },
    {
      "id": "kanton/ZH/341.1/art_19",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "19",
      "artikelLabel": "§ 19",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Schutzunterkünfte bieten gewaltbetroffenen Menschen jederzeit vorübergehende Wohn- und Aufenthaltsmöglichkeiten und persönliche Unterstützung."
        },
        {
          "absatz": "2",
          "text": "Angebote, die sich ausschliesslich an Kinder und Jugendliche richten, gelten nicht als Schutzunterkünfte."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "35e90a4852dcf17d6f34a4d0eee83efc6e1e504ff808574786c249ddf72b0e62"
    },
    {
      "id": "kanton/ZH/341.1/art_20",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "20",
      "artikelLabel": "§ 20",
      "bloecke": [
        {
          "absatz": null,
          "text": "Eine Anerkennung als Schutzunterkunft setzt neben den in § 7 a EG OHG genannten Anforderungen voraus, dass",
          "items": [
            {
              "marke": "a",
              "text": "interkantonal anerkannte Standards eingehalten werden,"
            },
            {
              "marke": "b",
              "text": "die strategische Leitung und die operative Tätigkeit getrennt sind."
            }
          ]
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "906ee048fc8325958db37188fbb80167203b51e82842735d558a5ffef81099b1"
    },
    {
      "id": "kanton/ZH/341.1/art_21",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "21",
      "artikelLabel": "§ 21",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Subvention wird pro Tag und Zimmer ausgerichtet. Ihre Höhe richtet sich nach den Kosten, die für den Betrieb einer Schutzunterkunft unabhängig von der Auslastung anfallen."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "259bfcb7232c4d47e9339516a464569be496c01f4f82ebc3a7fafd9af983ead8"
    },
    {
      "id": "kanton/ZH/341.1/art_22",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "22",
      "artikelLabel": "§ 22",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Sicherheitsdirektion und die Schutzunterkünfte schliessen Leistungsvereinbarungen für längstens vier Jahre ab."
        },
        {
          "absatz": "2",
          "text": "Kommt keine Vereinbarung zustande, legt die Direktion die Leistungen der Schutzunterkunft und die Subvention fest."
        }
      ],
      "stand": "2024-04-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-341_1-2013_04_30-2013_07_01-124.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "95258e8bfdc351c84eabe69292f10682f71da6bfaa4a3f6a7b8c55ddc50864a3",
      "sha": "6aaebd9ab808e71248fa49851fba8eb99a42e3084b85a550ca84bfb28d69f7a4"
    },
    {
      "id": "kanton/ZH/341.1/art_23",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Opferhilfeverordnung (KOHV) (LS 341.1)",
      "artikel": "23",
      "artikelLabel": "§ 23",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Aufsicht richtet sich nach § 7 c EG OHG."
        }
      ],

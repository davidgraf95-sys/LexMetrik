{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/321.2/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": null,
          "text": "Diese Verordnung regelt den Vollzug des Ordnungsbussengesetzes vom 18. März 2016 (OBG) und der kantonalrechtlichen Ordnungsbussen."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "7286186e03d516ade296064673a4c954b7d5abec079857650c8c3c98d5990101"
    },
    {
      "id": "kanton/ZH/321.2/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Übertretungen von Vorschriften des kantonalen Rechts gemäss Anhang 1 werden mit Ordnungsbussen bestraft."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "72eda791249dcb8690411e3963e6336bdc1c3abf1c61f002e74613682847132e"
    },
    {
      "id": "kanton/ZH/321.2/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Kantonspolizei ist für die Erhebung der bundes- und kantonalrechtlichen Ordnungsbussen zuständig."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "0fc4bc07333d8fece42727f376e01c1f457b73e98f9579b195f252cec829c64f"
    },
    {
      "id": "kanton/ZH/321.2/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Stadt- und Gemeindepolizeien sind für die Erhebung von bundes- und kantonalrechtlichen Ordnungsbussen gemäss §§ 12 und 17– 23 des Polizeiorganisationsgesetzes vom 29. November 2004 zuständig."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "45b1192bc94c2663d9adf729720a652688a573f9fadf9c570a6b09cf2c7edd74"
    },
    {
      "id": "kanton/ZH/321.2/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die weiteren Organe gemäss Anhang 2 sind für die Erhebung von bundes- und kantonalrechtlichen Ordnungsbussen im Bereich der aufgeführten Erlasse zuständig."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "c465333591ee49eee13337c0158619065e514eb888e024589816284b511977d6"
    },
    {
      "id": "kanton/ZH/321.2/art_6",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "6",
      "artikelLabel": "§ 6",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Auf Gesuch kann der Regierungsrat politische Gemeinden ohne eigenes Polizeikorps zur Erhebung von Ordnungsbussen betreffend ruhenden Verkehr gemäss Anhang 1 Ziff. 2 der Ordnungsbussenverordnung vom 16. Januar 2019 (OBV) auf ihrem Gebiet ermächtigen."
        },
        {
          "absatz": "2",
          "text": "Vorbehalten bleiben §§ 8–10."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "6034e756f8857e85604a16ea4a9eb9c46c94b27a1d9bec4aa39e1f5db7280211"
    },
    {
      "id": "kanton/ZH/321.2/art_7",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Kantonspolizei, die Stadt- und Gemeindepolizeien sowie die dazu ermächtigten politischen Gemeinden können für die Erhebung von bundesrechtlichen Ordnungsbussen betreffend ruhenden Verkehr gemäss Anhang 1 Ziff. 2 OBV Hilfskräfte anstellen oder Dritte beauftragen."
        },
        {
          "absatz": "2",
          "text": "Die Kantonspolizei und die Stadtpolizeien Zürich und Winterthur können für die Erhebung von bundesrechtlichen Ordnungsbussen für Übertretungen nach dem Strassenverkehrsgesetz vom 19. Dezember 1958 und dem Bundesgesetz vom 3. Oktober 1951 über die Betäubungsmittel und die psychotropen Stoffe sowie von kantonalrechtlichen Ordnungsbussen Hilfskräfte anstellen."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "9f13ae79e7b2a33cbbc5390ed3435e00fbdcc9069566a87de7c01b25acc6797c"
    },
    {
      "id": "kanton/ZH/321.2/art_8",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "8",
      "artikelLabel": "§ 8",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die für die Erhebung von Ordnungsbussen eingesetzten Personen benötigen eine Bewilligung. Ausgenommen sind Polizistinnen und Polizisten, die über den eidgenössischen Fachausweis verfügen."
        },
        {
          "absatz": "2",
          "text": "Die Städte Zürich und Winterthur erteilen die Bewilligungen den Personen, die von ihren Stadtpolizeien eingesetzt werden."
        },
        {
          "absatz": "3",
          "text": "Die nach § 5 bezeichneten Organe sowie die von ihnen eingesetzten Personen benötigen eine Bewilligung der Direktion oder Gemeinde, der sie unterstehen bzw. angehören."
        },
        {
          "absatz": "4",
          "text": "Die übrigen Bewilligungen erteilt die Kantonspolizei."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "63ecd02c4f5698359ff2184d38f803ba42eb6a1e5ec1fb6ec3a640d7c6de3d2a"
    },
    {
      "id": "kanton/ZH/321.2/art_9",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "9",
      "artikelLabel": "§ 9",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Voraussetzung für die Erteilung der Bewilligung ist eine genügende Ausbildung."
        },
        {
          "absatz": "2",
          "text": "Die Bewilligungsbehörden legen die Anforderungen an die genügende Ausbildung fest."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "69596452441c9a1c8de823c29cff3ff736ba6325a98cd83fa0c9c48c51dd1523"
    },
    {
      "id": "kanton/ZH/321.2/art_10",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "10",
      "artikelLabel": "§ 10",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die eingesetzten Personen zeigen bei der Erhebung von Ordnungsbussen ihren Dienstausweis vor."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "e21299e3a3c0400a83e90307a4b3e4eb3e86c6b64da8401a7c582e0e3d5b2576"
    },
    {
      "id": "kanton/ZH/321.2/art_11",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "11",
      "artikelLabel": "§ 11",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Bussenformulare müssen die Anforderungen von Art. 9 OBG erfüllen."
        },
        {
          "absatz": "2",
          "text": "Die Sicherheitsdirektion kann Vorschriften zur Gestaltung der Formulare erlassen."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "a8c64109fa2f002b6ce3241c33042231081e866bc8531b7391e32220250ca664"
    },
    {
      "id": "kanton/ZH/321.2/art_12",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "12",
      "artikelLabel": "§ 12",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die Abwicklung des Ordnungsbussenverfahrens darf nicht an Private übertragen werden."
        },
        {
          "absatz": "2",
          "text": "Die Kantonspolizei stellt durch organisatorische und technische Massnahmen sicher, dass die bei der Abwicklung des Ordnungsbussenverfahrens für andere Organe des Kantons oder der Gemeinden (§ 175 a GOG) erhaltenen Daten nicht zu anderen Zwecken verwendet werden."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "39a1f26adbc45d612e965cf0bc6e996882f808718c6e1d33ac7cbfdfb286838f"
    },
    {
      "id": "kanton/ZH/321.2/art_13",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Ordnungsbussenverordnung (KOBV) (LS 321.2)",
      "artikel": "13",
      "artikelLabel": "§ 13",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die nach bisherigem Recht erteilten Ermächtigungen von politischen Gemeinden zur Erhebung von Ordnungsbussen im Strassenverkehr behalten ihre Gültigkeit im Umfang von § 6 Abs. 1."
        },
        {
          "absatz": "2",
          "text": "Die nach bisherigem Recht erteilten Bewilligungen der Kantonspolizei an die zur Erhebung von Ordnungsbussen eingesetzten Personen behalten ihre Gültigkeit im Umfang von § 7 Abs. 1."
        },
        {
          "absatz": "3",
          "text": "Die nach bisherigem Recht von den Städten Zürich und Winterthur erteilten Bewilligungen an die zur Erhebung von Ordnungsbussen eingesetzten Personen behalten ihre Gültigkeit im Umfang von § 7 Abs. 2."
        },
        {
          "absatz": "4",
          "text": "Die nach bisherigem Recht durch den Gemeindevorstand vorgenommenen Bezeichnungen der mit der Führung des Einwohnerregisters betrauten Personen gelten als Bewilligungen nach § 8."
        },
        {
          "absatz": "5",
          "text": "Polizistinnen und Polizisten, die eine Polizeischule absolviert haben und bei Inkrafttreten dieser Verordnung seit mindestens fünf Jahren im Beruf tätig sind, sind den Polizistinnen und Polizisten mit eidgenössischem Fachausweis gleichgestellt."
        }
      ],
      "stand": "2025-06-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-321_2-2019_12_10-2020_01_01-131.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "dddb1a05ea417a354b8e2c30b1978e5caa3c5e5326baebf04d413c1f6fadf42a",
      "sha": "5d90a66568402d2345e3d6a3db35f1b37e2a57cdfdd7932ff57cf3348ab898bb"
    }
  ]
}
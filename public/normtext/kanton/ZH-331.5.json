{
  "erzeugt": "2026-09-01",
  "eintraege": [
    {
      "id": "kanton/ZH/331.5/art_1",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über das Strafregister-Informationssystem VOSTRA (KStReV) (LS 331.5)",
      "artikel": "1",
      "artikelLabel": "§ 1",
      "bloecke": [
        {
          "absatz": null,
          "text": "Justizvollzug und Wiedereingliederung der Direktion der Justiz und des Innern betreibt die kantonale Koordinationsstelle für das Strafregister-Informationssystem VOSTRA (KOST) gemäss Art. 4 Abs. 1 StReG."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-331_5-2024_06_12-2024_10_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "8e175ec36c1637a45818d4255a9161dc11291b418efab7247053b37c3e5f85f4",
      "sha": "b6fd43551b0127951de573992ba4c7e2ba8777a3eda67edea6bab9e8ac88ee7f"
    },
    {
      "id": "kanton/ZH/331.5/art_2",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über das Strafregister-Informationssystem VOSTRA (KStReV) (LS 331.5)",
      "artikel": "2",
      "artikelLabel": "§ 2",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Die KOST erfüllt die Aufgaben gemäss Art. 4 Abs. 2 StReG."
        },
        {
          "absatz": "2",
          "text": "Sie trägt für folgende Behörden Daten in VOSTRA ein:",
          "items": [
            {
              "marke": "a",
              "text": "Justizvollzug und Wiedereingliederung,"
            },
            {
              "marke": "b",
              "text": "die Statthalterämter,"
            },
            {
              "marke": "c",
              "text": "das Migrationsamt,"
            },
            {
              "marke": "d",
              "text": "weitere kantonale Verwaltungsbehörden, die Strafverfahren durchführen oder Strafentscheide fällen."
            }
          ]
        },
        {
          "absatz": "3",
          "text": "Sie kann ausnahmsweise für Behörden gemäss §§ 5 und 7 Eintragungen oder Abfragen vornehmen."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-331_5-2024_06_12-2024_10_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "8e175ec36c1637a45818d4255a9161dc11291b418efab7247053b37c3e5f85f4",
      "sha": "61591690742c3895b8c387a6a5f85be456ac036832ab3156fe928d80adc250c4"
    },
    {
      "id": "kanton/ZH/331.5/art_3",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über das Strafregister-Informationssystem VOSTRA (KStReV) (LS 331.5)",
      "artikel": "3",
      "artikelLabel": "§ 3",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Behörden melden ihre Daten mit den erforderlichen Angaben spätestens sechs Arbeitstage vor Ablauf der Eintragungsfrist der KOST."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-331_5-2024_06_12-2024_10_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "8e175ec36c1637a45818d4255a9161dc11291b418efab7247053b37c3e5f85f4",
      "sha": "bff7d50533e8a83eceba222eeae3b193cd3c496e10539bbc990a33ac2a1e9b00"
    },
    {
      "id": "kanton/ZH/331.5/art_4",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über das Strafregister-Informationssystem VOSTRA (KStReV) (LS 331.5)",
      "artikel": "4",
      "artikelLabel": "§ 4",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Der Datenaustausch zwischen der KOST und den Behörden, für welche die KOST Eintragungen oder Abfragen vornimmt, erfolgt elektronisch und verschlüsselt."
        },
        {
          "absatz": "2",
          "text": "Weitere Vorgaben des Bundes- und des kantonalen Rechts zur Datensicherheit sind anwendbar."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-331_5-2024_06_12-2024_10_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "8e175ec36c1637a45818d4255a9161dc11291b418efab7247053b37c3e5f85f4",
      "sha": "cd77938b7765a5c5dc06badff7df7ae0da1d4011e401d0cd80f52d7dc22188ca"
    },
    {
      "id": "kanton/ZH/331.5/art_5",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über das Strafregister-Informationssystem VOSTRA (KStReV) (LS 331.5)",
      "artikel": "5",
      "artikelLabel": "§ 5",
      "bloecke": [
        {
          "absatz": null,
          "text": "Folgende Behörden tragen ihre Daten in der Regel selbst in VOSTRA ein:",
          "items": [
            {
              "marke": "a",
              "text": "die Strafgerichte,"
            },
            {
              "marke": "b",
              "text": "die Staatsanwaltschaften,"
            },
            {
              "marke": "c",
              "text": "die Jugendanwaltschaften."
            }
          ]
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-331_5-2024_06_12-2024_10_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "8e175ec36c1637a45818d4255a9161dc11291b418efab7247053b37c3e5f85f4",
      "sha": "081e47b6d6c0ec19a16365199db7b98b8fb551f2752bd94b0dfd0a4fcb05be00"
    },
    {
      "id": "kanton/ZH/331.5/art_6",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über das Strafregister-Informationssystem VOSTRA (KStReV) (LS 331.5)",
      "artikel": "6",
      "artikelLabel": "§ 6",
      "bloecke": [
        {
          "absatz": "1",
          "text": "Bei jeder Behörde ist eine Stelle eintragungsberechtigt."
        },
        {
          "absatz": "2",
          "text": "Das Obergericht und die Direktion der Justiz und des Innern erlassen die erforderlichen Weisungen."
        },
        {
          "absatz": "3",
          "text": "Sie können eine Stelle mit der Eintragung für mehrere oder alle ihnen untergeordneten Behörden betrauen."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-331_5-2024_06_12-2024_10_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "8e175ec36c1637a45818d4255a9161dc11291b418efab7247053b37c3e5f85f4",
      "sha": "68126abdfd09ba3a5d7058e753f1aa78a9992c7b24b89a2573b63a64de0f39e4"
    },
    {
      "id": "kanton/ZH/331.5/art_7",
      "ebene": "kanton",
      "quelle": "ZH",
      "erlass": "Kantonale Verordnung über das Strafregister-Informationssystem VOSTRA (KStReV) (LS 331.5)",
      "artikel": "7",
      "artikelLabel": "§ 7",
      "bloecke": [
        {
          "absatz": null,
          "text": "Die Behörden, die gemäss Art. 45–49 StReG zur Online- Abfrage berechtigt sind, nehmen die Abfragen in VOSTRA in der Regel selbst vor."
        }
      ],
      "stand": "2024-10-01",
      "quelleUrl": "https://www.zh.ch/de/politik-staat/gesetze-beschluesse/gesetzessammlung/zhlex-ls/erlass-331_5-2024_06_12-2024_10_01-126.html",
      "abgerufen": "2026-09-01",
      "fassungsToken": "8e175ec36c1637a45818d4255a9161dc11291b418efab7247053b37c3e5f85f4",
      "sha": "d3703728637bf325e41dda38d99cb35058a19774810d3422240a8b1fa5327ba3"
    }
  ]
}